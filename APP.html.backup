<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SINU OPS SYSTEM - PT. Sinergi Internet Nusantara</title>
<script src="https://cdn.tailwindcss.com"></script>
<script>tailwind.config={darkMode:"class"}</script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"/>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script src="https://cdn.jsdelivr.net/npm/@tensorflow/tfjs"></script>
<script src="https://cdn.jsdelivr.net/npm/@tensorflow-models/blazeface"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<style>
@import url("https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap");
*{box-sizing:border-box;}
body{font-family:"Plus Jakarta Sans",sans-serif;}
/* SCROLLBAR */
::-webkit-scrollbar{width:4px;height:4px;}
::-webkit-scrollbar-track{background:transparent;}
::-webkit-scrollbar-thumb{background:#cbd5e1;border-radius:4px;}
.dark ::-webkit-scrollbar-thumb{background:#475569;}
.scrollbar-hide::-webkit-scrollbar{display:none;}
.scrollbar-hide{-ms-overflow-style:none;scrollbar-width:none;}
/* ANIMATIONS */
@keyframes fadeUp{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:translateY(0)}}
@keyframes scan{0%{top:0}50%{top:88%}100%{top:0}}
@keyframes pulse-ring{0%{transform:scale(.95);opacity:.8}70%{transform:scale(1.05);opacity:.3}100%{transform:scale(.95);opacity:.8}}
.fade-up{animation:fadeUp .35s ease-out;}
.scan-line{animation:scan 2s infinite ease-in-out;position:absolute;left:0;right:0;height:2px;background:linear-gradient(90deg,transparent,#3b82f6,transparent);box-shadow:0 0 8px #3b82f6;}
/* MAIN NAV TABS */
.tab-btn{transition:all .2s;}
.tab-btn.active{background:#1e293b;color:#fff;box-shadow:0 4px 14px rgba(30,41,59,.3);}
.dark .tab-btn.active{background:#3b82f6;box-shadow:0 4px 14px rgba(59,130,246,.35);}
/* SUB NAV PILLS — MODERN LARGE */
.subnav-wrap{display:flex;gap:8px;padding:6px;overflow-x:auto;scrollbar-width:none;}
.subnav-wrap::-webkit-scrollbar{display:none;}
.snpill{display:flex;flex-direction:column;align-items:center;gap:5px;padding:12px 16px;border-radius:16px;font-size:11px;font-weight:800;letter-spacing:.3px;color:#64748b;background:#f1f5f9;border:1.5px solid #e2e8f0;white-space:nowrap;cursor:pointer;transition:all .2s;min-width:70px;flex-shrink:0;}
.snpill i{font-size:20px;}
.dark .snpill{background:#1e293b;border-color:#334155;color:#94a3b8;}
.snpill:hover{background:#e2e8f0;color:#1e293b;transform:translateY(-1px);}
.dark .snpill:hover{background:#273548;color:#e2e8f0;}
.snpill.active{background:#1e293b;color:#fff;border-color:#1e293b;box-shadow:0 6px 16px rgba(30,41,59,.3);transform:translateY(-1px);}
.dark .snpill.active{background:#3b82f6;border-color:#3b82f6;box-shadow:0 6px 16px rgba(59,130,246,.4);}
/* COMPACT PHOTO GRID */
.cam-cell{display:flex;flex-direction:column;gap:4px;}
.cam-cell label{font-size:9px;font-weight:800;text-transform:uppercase;letter-spacing:.5px;color:#64748b;text-align:center;}
.cam-box{position:relative;background:#f8fafc;border:1.5px dashed #cbd5e1;border-radius:10px;overflow:hidden;cursor:pointer;transition:all .2s;aspect-ratio:1;}
.dark .cam-box{background:#1e293b;border-color:#475569;}
.cam-box:hover{border-color:#3b82f6;background:#eff6ff;}
.dark .cam-box:hover{background:#172554;}
.cam-box img{width:100%;height:100%;object-fit:cover;display:block;}
.cam-box .cam-ph{display:flex;flex-direction:column;align-items:center;justify-content:center;height:100%;gap:3px;color:#94a3b8;}
.cam-box .cam-ph i{font-size:18px;}
.cam-box .cam-ph span{font-size:9px;font-weight:700;}
.cam-box.has-photo .cam-ph{display:none;}
.cam-box.has-photo img{display:block;}
.cam-box img{display:none;}
/* CAMERA ABSENSI */
.camera-preview-wrap{position:relative;width:100%;background:#0f172a;border-radius:14px;overflow:hidden;min-height:160px;display:flex;align-items:center;justify-content:center;}
.camera-preview-wrap video,.camera-preview-wrap img{width:100%;height:160px;object-fit:cover;display:block;}
/* LEAFLET */
.leaflet-container{border-radius:14px;}
/* STEP INDICATOR */
.step-indicator{transition:all .2s;}
.step-indicator.active{background:#2563eb;color:#fff;border-color:#2563eb;}
/* PERIOD BTN */
.period-btn.active{background:#2563eb;color:#fff;}
/* FILTER ROLE BTN */
.filter-role-btn.active{background:#1e293b;color:#fff;border-color:#1e293b;}
.dark .filter-role-btn.active{background:#3b82f6;color:#fff;border-color:#3b82f6;}
/* PODIUM */
.podium-card{transition:all .2s;}
.podium-card:hover{transform:translateY(-3px);}
/* POINT BADGE */
.pt-badge-a{background:#dcfce7;color:#166534;}
.pt-badge-b{background:#dbeafe;color:#1e40af;}
.pt-badge-c{background:#fef9c3;color:#854d0e;}
.pt-badge-d{background:#fee2e2;color:#991b1b;}
.dark .pt-badge-a{background:#14532d;color:#86efac;}
.dark .pt-badge-b{background:#1e3a5f;color:#93c5fd;}
.dark .pt-badge-c{background:#422006;color:#fde047;}
.dark .pt-badge-d{background:#450a0a;color:#fca5a5;}
</style>
</head>
<body class="bg-[#eef2f6] dark:bg-slate-900 min-h-screen text-slate-800 dark:text-slate-100 transition-colors duration-300">

<!-- ===================== LOGIN ===================== -->
<div id="login-page" class="min-h-screen flex items-center justify-center px-4 py-8">
  <div class="w-full max-w-sm fade-up">
    <div class="bg-white dark:bg-slate-800 rounded-3xl p-8 shadow-2xl border border-slate-100 dark:border-slate-700 space-y-6">
      <div class="text-center space-y-3">
        <img src="https://lh3.googleusercontent.com/d/1dIupMI3Fe4hkqHwpan6Nr-HMbSgPTY5S" alt="PT SINu" class="h-12 object-contain mx-auto">
        <div><h1 class="text-xl font-black text-slate-900 dark:text-white tracking-tight">SINU OPS SYSTEM</h1><p class="text-xs text-slate-400 font-medium mt-0.5">Field Operations Portal v2.0</p></div>
      </div>
      <div id="login-error" class="hidden bg-rose-50 dark:bg-rose-950/50 border border-rose-200 dark:border-rose-800 rounded-2xl px-4 py-3 flex items-center gap-2 text-rose-600 dark:text-rose-400 text-xs font-semibold">
        <i class="fa-solid fa-circle-exclamation shrink-0"></i><span id="login-error-msg">Username atau password salah.</span>
      </div>
      <form id="login-form" onsubmit="handleLogin(event)" class="space-y-4">
        <div class="space-y-1.5">
          <label class="block text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Username</label>
          <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400"><i class="fa-solid fa-user text-sm"></i></div>
            <input type="text" id="login-username" required placeholder="Masukkan username" autocomplete="username"
              class="w-full pl-10 pr-4 py-3 bg-slate-50 dark:bg-slate-700/50 border border-slate-200 dark:border-slate-600 rounded-2xl text-sm font-medium text-slate-800 dark:text-slate-100 focus:outline-none focus:border-blue-600 focus:ring-2 focus:ring-blue-600/20 transition-all">
          </div>
        </div>
        <div class="space-y-1.5">
          <label class="block text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Password</label>
          <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400"><i class="fa-solid fa-lock text-sm"></i></div>
            <input type="password" id="login-password" required placeholder="Masukkan password" autocomplete="current-password"
              class="w-full pl-10 pr-10 py-3 bg-slate-50 dark:bg-slate-700/50 border border-slate-200 dark:border-slate-600 rounded-2xl text-sm font-medium text-slate-800 dark:text-slate-100 focus:outline-none focus:border-blue-600 focus:ring-2 focus:ring-blue-600/20 transition-all">
            <button type="button" onclick="togglePwd()" class="absolute inset-y-0 right-0 pr-3.5 flex items-center text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 transition-colors">
              <i id="pwd-eye-icon" class="fa-solid fa-eye text-sm"></i>
            </button>
          </div>
        </div>
        <button type="submit" id="btn-login"
          class="w-full py-3.5 bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-700 hover:to-indigo-700 text-white font-bold text-sm rounded-2xl transition-all shadow-lg shadow-blue-500/30 flex items-center justify-center gap-2 active:scale-[0.98]">
          <i class="fa-solid fa-right-to-bracket"></i><span>Masuk ke Sistem</span>
        </button>
      </form>
      <div class="bg-slate-50 dark:bg-slate-700/50 rounded-2xl p-3.5 border border-slate-100 dark:border-slate-700 space-y-2">
        <p class="text-[10px] font-black text-slate-500 dark:text-slate-400 uppercase tracking-wider flex items-center gap-1.5"><i class="fa-solid fa-circle-info text-blue-500"></i>Demo Akun</p>
        <div class="grid grid-cols-3 gap-1.5 text-[10px]">
          <div class="bg-white dark:bg-slate-800 rounded-xl p-2 border border-slate-100 dark:border-slate-600 text-center">
            <p class="font-black text-blue-600 dark:text-blue-400">teknisi1</p><p class="text-slate-400">pass123</p>
          </div>
          <div class="bg-white dark:bg-slate-800 rounded-xl p-2 border border-slate-100 dark:border-slate-600 text-center">
            <p class="font-black text-indigo-600 dark:text-indigo-400">admin</p><p class="text-slate-400">admin123</p>
          </div>
          <div class="bg-white dark:bg-slate-800 rounded-xl p-2 border border-slate-100 dark:border-slate-600 text-center">
            <p class="font-black text-emerald-600 dark:text-emerald-400">supervisor</p><p class="text-slate-400">super123</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- ===================== MAIN APP ===================== -->
<div id="main-app" class="hidden min-h-screen py-4 lg:py-8 px-3 lg:px-8">
  <div class="w-full max-w-md lg:max-w-6xl mx-auto space-y-4 lg:space-y-0 lg:grid lg:grid-cols-12 lg:gap-6 items-start">

    <!-- SIDEBAR KIRI -->
    <div class="lg:col-span-4 space-y-4 lg:sticky lg:top-6">

      <!-- HEADER CARD -->
      <div class="bg-white dark:bg-slate-800 rounded-3xl p-5 shadow-sm border border-slate-100 dark:border-slate-700 fade-up">
        <div class="flex items-center justify-between pb-3 border-b border-slate-100 dark:border-slate-700 mb-3">
          <img src="https://lh3.googleusercontent.com/d/1dIupMI3Fe4hkqHwpan6Nr-HMbSgPTY5S" alt="PT SINu" class="h-9 lg:h-11 object-contain">
          <div class="flex items-center gap-2">
            <button type="button" onclick="toggleTheme()" class="p-2 rounded-full bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-amber-400 hover:bg-slate-200 dark:hover:bg-slate-600 transition-all">
              <i id="theme-icon" class="fa-solid fa-moon text-sm"></i>
            </button>
            <div class="flex items-center gap-1.5 bg-emerald-50 dark:bg-emerald-950/50 text-emerald-600 dark:text-emerald-400 text-xs font-semibold px-3 py-1.5 rounded-full border border-emerald-100 dark:border-emerald-800">
              <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>Online
            </div>
          </div>
        </div>
        <div class="mb-3">
          <h1 class="font-black text-slate-900 dark:text-white text-lg lg:text-xl leading-tight">SINU OPS SYSTEM</h1>
          <p class="text-xs text-slate-400 font-medium">Field Operations Portal v2.0</p>
        </div>
        <!-- USER BAR -->
        <div class="bg-gradient-to-r from-blue-50 to-indigo-50 dark:from-blue-950/40 dark:to-indigo-950/40 rounded-2xl px-4 py-3 flex items-center justify-between border border-blue-100 dark:border-blue-900/50">
          <div class="flex items-center gap-2.5">
            <div id="user-avatar" class="w-9 h-9 rounded-xl bg-gradient-to-br from-blue-600 to-indigo-600 text-white font-black text-xs flex items-center justify-center shadow-md">--</div>
            <div><p id="user-display-name" class="text-xs font-extrabold text-slate-800 dark:text-slate-100 leading-tight">--</p><p id="user-role-badge" class="text-[10px] font-bold text-blue-600 dark:text-blue-400">--</p></div>
          </div>
          <button type="button" onclick="handleLogout()" class="flex items-center gap-1 text-[10px] font-bold text-rose-500 hover:text-rose-700 dark:hover:text-rose-400 transition-all px-2.5 py-1.5 rounded-xl hover:bg-rose-50 dark:hover:bg-rose-950/30">
            <i class="fa-solid fa-right-from-bracket text-xs"></i>Logout
          </button>
        </div>
        <!-- CLOCK -->
        <div class="mt-3 bg-slate-50/80 dark:bg-slate-700/50 rounded-2xl p-3 flex items-center justify-between text-xs text-slate-600 dark:text-slate-300 border border-slate-100 dark:border-slate-700">
          <div class="flex items-center gap-2 font-medium"><i class="fa-regular fa-calendar-check text-blue-600 dark:text-blue-400"></i><span id="current-date">--</span></div>
          <div class="flex items-center gap-1.5 font-bold bg-white dark:bg-slate-800 px-2.5 py-1 rounded-xl border border-slate-100 dark:border-slate-700">
            <i class="fa-regular fa-clock text-blue-600 dark:text-blue-400"></i><span id="current-time">00:00:00</span><span class="text-[10px] text-slate-400">WIB</span>
          </div>
        </div>
      </div>

      <!-- MAIN NAV -->
      <div id="main-nav" class="bg-white dark:bg-slate-800 rounded-2xl p-2 shadow-sm border border-slate-100 dark:border-slate-700 grid gap-1 fade-up"></div>

      <!-- INFO BANNER -->
      <div class="hidden lg:block bg-gradient-to-br from-slate-900 to-blue-950 rounded-3xl p-5 text-white shadow-md space-y-2 fade-up">
        <div class="flex items-center justify-between">
          <span class="text-[10px] font-bold tracking-widest uppercase bg-white/10 px-2.5 py-1 rounded-full text-blue-200">Operational Info</span>
          <i class="fa-solid fa-circle-info text-blue-300 text-sm"></i>
        </div>
        <p class="text-xs text-blue-100 leading-relaxed font-medium">Sistem terintegrasi Field Operations, WO, Absensi & Asset Management PT. SINu v2.0</p>
        <div class="grid grid-cols-2 gap-2 pt-1">
          <div class="bg-white/10 rounded-xl p-2 text-center"><p class="text-[10px] text-blue-200">Build</p><p class="text-xs font-black">2026.08-v2</p></div>
          <div class="bg-white/10 rounded-xl p-2 text-center"><p class="text-[10px] text-blue-200">Status</p><p class="text-xs font-black text-emerald-400">Active</p></div>
        </div>
      </div>
    </div>

    <!-- KONTEN KANAN -->
    <div class="lg:col-span-8 space-y-4">

      <!-- ===== DASHBOARD ===== -->
      <div id="section-dashboard" class="main-section space-y-4 fade-up">

        <!-- FILTER BAR -->
        <div class="bg-white dark:bg-slate-800 rounded-2xl px-4 py-3 shadow-sm border border-slate-100 dark:border-slate-700 flex flex-wrap items-center justify-between gap-3">
          <div class="flex items-center gap-2 flex-wrap">
            <span class="text-[10px] font-extrabold text-slate-400 uppercase tracking-wider">Divisi:</span>
            <button type="button" onclick="setRoleFilter('All')" id="filter-role-All" class="filter-role-btn active px-3 py-1.5 rounded-xl text-xs font-bold border border-slate-200 dark:border-slate-600 text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 transition-all">Semua</button>
            <button type="button" onclick="setRoleFilter('Teknisi')" id="filter-role-Teknisi" class="filter-role-btn px-3 py-1.5 rounded-xl text-xs font-bold border border-slate-200 dark:border-slate-600 text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 transition-all">Teknisi</button>
            <button type="button" onclick="setRoleFilter('CS')" id="filter-role-CS" class="filter-role-btn px-3 py-1.5 rounded-xl text-xs font-bold border border-slate-200 dark:border-slate-600 text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 transition-all">CS/Admin</button>
            <button type="button" onclick="setRoleFilter('NOC')" id="filter-role-NOC" class="filter-role-btn px-3 py-1.5 rounded-xl text-xs font-bold border border-slate-200 dark:border-slate-600 text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 transition-all">NOC</button>
          </div>
          <div class="flex items-center gap-2">
            <select id="recapMonthSelect" onchange="onFilterPeriodChange()" class="bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-xl px-2.5 py-1.5 text-xs font-bold text-slate-700 dark:text-slate-200 focus:outline-none focus:border-blue-600">
              <option value="0">Januari</option><option value="1">Februari</option><option value="2">Maret</option><option value="3">April</option><option value="4">Mei</option><option value="5">Juni</option><option value="6">Juli</option><option value="7">Agustus</option><option value="8">September</option><option value="9">Oktober</option><option value="10">November</option><option value="11">Desember</option>
            </select>
            <select id="recapYearSelect" onchange="onFilterPeriodChange()" class="bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-xl px-2.5 py-1.5 text-xs font-bold text-slate-700 dark:text-slate-200 focus:outline-none focus:border-blue-600">
              <option value="2025">2025</option><option value="2026">2026</option><option value="2027">2027</option>
            </select>
          </div>
        </div>

        <!-- WO SUMMARY + DONUT -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <!-- WO STATS -->
          <div class="bg-white dark:bg-slate-800 rounded-3xl p-5 shadow-sm border border-slate-100 dark:border-slate-700 space-y-3">
            <div class="flex items-center justify-between pb-3 border-b border-slate-100 dark:border-slate-700">
              <div><h2 class="text-sm font-extrabold text-slate-900 dark:text-white flex items-center gap-2"><i class="fa-solid fa-clipboard-list text-blue-600 dark:text-blue-400"></i>Work Order Hari Ini</h2><p class="text-[11px] text-slate-400 mt-0.5">Status real-time aktivitas WO</p></div>
            </div>
            <div class="grid grid-cols-2 gap-2.5">
              <div class="bg-blue-50 dark:bg-blue-950/40 rounded-2xl p-3.5 border border-blue-100 dark:border-blue-900">
                <p class="text-[10px] font-extrabold text-blue-500 uppercase tracking-wider">Total WO</p>
                <p class="text-3xl font-black text-blue-600 dark:text-blue-400 mt-1 leading-none wo-summary-total">12</p>
                <p class="text-[10px] text-blue-400 mt-1">Tiket masuk hari ini</p>
              </div>
              <div class="bg-emerald-50 dark:bg-emerald-950/40 rounded-2xl p-3.5 border border-emerald-100 dark:border-emerald-900">
                <p class="text-[10px] font-extrabold text-emerald-500 uppercase tracking-wider">Selesai</p>
                <p class="text-3xl font-black text-emerald-600 dark:text-emerald-400 mt-1 leading-none wo-summary-selesai">8</p>
                <p class="text-[10px] text-emerald-400 mt-1">Berhasil dikerjakan</p>
              </div>
              <div class="bg-amber-50 dark:bg-amber-950/40 rounded-2xl p-3.5 border border-amber-100 dark:border-amber-900">
                <p class="text-[10px] font-extrabold text-amber-500 uppercase tracking-wider">Proses</p>
                <p class="text-3xl font-black text-amber-600 dark:text-amber-400 mt-1 leading-none wo-summary-proses">3</p>
                <p class="text-[10px] text-amber-400 mt-1">Sedang dikerjakan</p>
              </div>
              <div class="bg-rose-50 dark:bg-rose-950/40 rounded-2xl p-3.5 border border-rose-100 dark:border-rose-900">
                <p class="text-[10px] font-extrabold text-rose-500 uppercase tracking-wider">Return</p>
                <p class="text-3xl font-black text-rose-600 dark:text-rose-400 mt-1 leading-none wo-summary-return">1</p>
                <p class="text-[10px] text-rose-400 mt-1">Dikembalikan</p>
              </div>
            </div>
          </div>

          <!-- DONUT CHART KEHADIRAN -->
          <div class="bg-white dark:bg-slate-800 rounded-3xl p-5 shadow-sm border border-slate-100 dark:border-slate-700 space-y-3">
            <div class="pb-3 border-b border-slate-100 dark:border-slate-700">
              <h2 class="text-sm font-extrabold text-slate-900 dark:text-white flex items-center gap-2"><i class="fa-solid fa-chart-pie text-indigo-600 dark:text-indigo-400"></i>Komposisi Kehadiran</h2>
              <p class="text-[11px] text-slate-400 mt-0.5">Distribusi status kehadiran bulan ini</p>
            </div>
            <div class="flex items-center gap-4">
              <div class="relative w-28 h-28 shrink-0">
                <canvas id="attendanceDonut"></canvas>
                <div class="absolute inset-0 flex flex-col items-center justify-center pointer-events-none">
                  <p id="donut-center-val" class="text-xl font-black text-slate-900 dark:text-white leading-none">0%</p>
                  <p class="text-[9px] text-slate-400 font-semibold">Hadir</p>
                </div>
              </div>
              <div class="flex-1 space-y-2 text-xs">
                <div class="flex items-center justify-between"><div class="flex items-center gap-2"><span class="w-2.5 h-2.5 rounded-full bg-emerald-500 shrink-0"></span><span class="text-slate-600 dark:text-slate-300 font-semibold">Tepat Waktu</span></div><span id="donut-tepat" class="font-black text-emerald-600 dark:text-emerald-400">0%</span></div>
                <div class="flex items-center justify-between"><div class="flex items-center gap-2"><span class="w-2.5 h-2.5 rounded-full bg-amber-500 shrink-0"></span><span class="text-slate-600 dark:text-slate-300 font-semibold">Terlambat</span></div><span id="donut-terlambat" class="font-black text-amber-600 dark:text-amber-400">0%</span></div>
                <div class="flex items-center justify-between"><div class="flex items-center gap-2"><span class="w-2.5 h-2.5 rounded-full bg-rose-500 shrink-0"></span><span class="text-slate-600 dark:text-slate-300 font-semibold">Izin Sakit</span></div><span id="donut-sakit" class="font-black text-rose-600 dark:text-rose-400">0%</span></div>
                <div class="flex items-center justify-between"><div class="flex items-center gap-2"><span class="w-2.5 h-2.5 rounded-full bg-indigo-500 shrink-0"></span><span class="text-slate-600 dark:text-slate-300 font-semibold">Izin Cuti</span></div><span id="donut-cuti" class="font-black text-indigo-600 dark:text-indigo-400">0%</span></div>
                <div class="flex items-center justify-between"><div class="flex items-center gap-2"><span class="w-2.5 h-2.5 rounded-full bg-slate-400 shrink-0"></span><span class="text-slate-600 dark:text-slate-300 font-semibold">Alpa</span></div><span id="donut-alpa" class="font-black text-slate-500">0%</span></div>
              </div>
            </div>
          </div>
        </div>

        <!-- TOP 3 PODIUM -->
        <div class="bg-white dark:bg-slate-800 rounded-3xl p-5 shadow-sm border border-slate-100 dark:border-slate-700 space-y-4">
          <div class="flex items-center justify-between pb-3 border-b border-slate-100 dark:border-slate-700">
            <div><h2 class="text-sm font-extrabold text-slate-900 dark:text-white flex items-center gap-2"><i class="fa-solid fa-trophy text-amber-500"></i>Top 3 Employee of the Month</h2><p class="text-[11px] text-slate-400 mt-0.5">Berdasarkan total point kehadiran + kinerja tertinggi</p></div>
          </div>
          <div class="flex items-end justify-center gap-3 pt-2" id="podium-container">
            <!-- Diisi JS: #2, #1, #3 -->
            <div class="text-center text-xs text-slate-400 py-4 w-full">Memuat data...</div>
          </div>
        </div>

        <!-- KPI KLASEMEN SINGKAT -->
        <div class="bg-white dark:bg-slate-800 rounded-3xl p-5 shadow-sm border border-slate-100 dark:border-slate-700 space-y-4">
          <div class="flex items-center justify-between pb-3 border-b border-slate-100 dark:border-slate-700">
            <div><h2 class="text-sm font-extrabold text-slate-900 dark:text-white flex items-center gap-2"><i class="fa-solid fa-ranking-star text-blue-600 dark:text-blue-400"></i>Klasemen KPI Singkat</h2><p class="text-[11px] text-slate-400 mt-0.5">Point Kehadiran + Point Kinerja per individu</p></div>
          </div>
          <div id="kpi-klasemen-list" class="space-y-2">
            <div class="text-center text-xs text-slate-400 py-4">Memuat data...</div>
          </div>
        </div>

        <!-- TREN KEHADIRAN + REKAP KARYAWAN -->
        <div class="bg-white dark:bg-slate-800 rounded-3xl shadow-sm border border-slate-100 dark:border-slate-700 overflow-hidden">
          <!-- HEADER -->
          <div class="p-5 lg:p-6 border-b border-slate-100 dark:border-slate-700 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
            <div><h2 class="text-sm font-extrabold text-slate-900 dark:text-white flex items-center gap-2"><i class="fa-solid fa-chart-line text-blue-600 dark:text-blue-400"></i>Tren Kehadiran & Rekapitulasi</h2><p class="text-[11px] text-slate-400 mt-0.5">Statistik kehadiran dan detail per karyawan</p></div>
            <div class="bg-slate-100 dark:bg-slate-700 p-1 rounded-xl flex items-center gap-0.5">
              <button type="button" onclick="setChartPeriod('daily')" id="period-daily" class="period-btn px-2.5 py-1 rounded-lg text-[11px] font-bold text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white transition-all">Harian</button>
              <button type="button" onclick="setChartPeriod('weekly')" id="period-weekly" class="period-btn px-2.5 py-1 rounded-lg text-[11px] font-bold text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white transition-all">Mingguan</button>
              <button type="button" onclick="setChartPeriod('monthly')" id="period-monthly" class="period-btn active px-2.5 py-1 rounded-lg text-[11px] font-bold text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white transition-all">Bulanan</button>
            </div>
          </div>
          <!-- STAT STRIP -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-px bg-slate-100 dark:bg-slate-700/50">
            <div class="bg-white dark:bg-slate-800 px-5 py-4 text-center"><p class="text-[10px] font-extrabold text-emerald-500 uppercase tracking-wider">Tepat Waktu</p><p class="text-2xl font-black text-emerald-600 dark:text-emerald-400 mt-1" id="stat-present">0%</p></div>
            <div class="bg-white dark:bg-slate-800 px-5 py-4 text-center"><p class="text-[10px] font-extrabold text-amber-500 uppercase tracking-wider">Terlambat</p><p class="text-2xl font-black text-amber-600 dark:text-amber-400 mt-1" id="stat-late">0%</p></div>
            <div class="bg-white dark:bg-slate-800 px-5 py-4 text-center"><p class="text-[10px] font-extrabold text-rose-500 uppercase tracking-wider">Izin Sakit</p><p class="text-2xl font-black text-rose-600 dark:text-rose-400 mt-1" id="stat-sick">0%</p></div>
            <div class="bg-white dark:bg-slate-800 px-5 py-4 text-center"><p class="text-[10px] font-extrabold text-indigo-500 uppercase tracking-wider">Izin Cuti</p><p class="text-2xl font-black text-indigo-600 dark:text-indigo-400 mt-1" id="stat-leave">0%</p></div>
          </div>
          <!-- CHART -->
          <div class="p-5 lg:p-6 border-b border-slate-100 dark:border-slate-700">
            <div class="h-52 relative"><canvas id="mainAttendanceChart"></canvas></div>
          </div>
          <!-- REKAP HEADER -->
          <div class="px-5 lg:px-6 py-4 border-b border-slate-100 dark:border-slate-700 flex flex-col sm:flex-row sm:items-center justify-between gap-3 bg-slate-50/60 dark:bg-slate-700/20">
            <div class="flex items-center gap-2"><i class="fa-solid fa-users text-blue-600 dark:text-blue-400 text-sm"></i><h3 class="text-sm font-extrabold text-slate-800 dark:text-slate-100">Rekapitulasi Karyawan</h3></div>
            <div class="flex items-center gap-2 flex-wrap">
              <button type="button" id="btn-tambah-karyawan" onclick="openAddEmployeeModal()" class="hidden px-3 py-1.5 bg-blue-600 hover:bg-blue-700 text-white rounded-xl text-xs font-bold transition-all shadow-sm flex items-center gap-1.5 shrink-0"><i class="fa-solid fa-user-plus text-xs"></i>Tambah</button>
              <select id="recapPeriodSelect" onchange="updateRecapTable()" class="bg-white dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-xl px-3 py-1.5 text-xs font-bold text-slate-700 dark:text-slate-200 focus:outline-none focus:border-blue-600">
                <option value="daily">Harian</option><option value="weekly">Mingguan</option><option value="monthly" selected>Bulanan</option>
              </select>
              <div class="relative"><input type="text" id="searchIndividual" onkeyup="filterIndividualList()" placeholder="Cari karyawan..." class="pl-8 pr-3 py-1.5 bg-white dark:bg-slate-700 border border-slate-200 dark:border-slate-600 text-slate-800 dark:text-slate-100 rounded-xl text-xs focus:outline-none focus:border-blue-600 w-40"><i class="fa-solid fa-magnifying-glass absolute left-2.5 top-2 text-slate-400 text-[10px]"></i></div>
            </div>
          </div>
          <!-- TABEL REKAP -->
          <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
              <thead><tr class="bg-slate-50 dark:bg-slate-700/50 text-[10px] font-extrabold text-slate-500 dark:text-slate-400 uppercase tracking-wider border-b border-slate-100 dark:border-slate-700">
                <th class="py-3 px-4">Nama</th><th class="py-3 px-3 text-center">Peran</th><th class="py-3 px-3 text-center">Hadir</th><th class="py-3 px-3 text-center">Tepat</th><th class="py-3 px-3 text-center">Terlambat</th><th class="py-3 px-3 text-center">Sakit</th><th class="py-3 px-3 text-center">Cuti</th><th class="py-3 px-3 text-center">%</th><th class="py-3 px-3 text-center">Pt.Hadir</th><th class="py-3 px-3 text-center">Grade</th><th id="col-aksi-karyawan" class="py-3 px-3 text-center hidden">Aksi</th>
              </tr></thead>
              <tbody id="individual-recap-table-body" class="divide-y divide-slate-100 dark:divide-slate-700 text-xs font-medium text-slate-700 dark:text-slate-200"></tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- ===== TUGAS ===== -->
      <div id="section-tugas" class="main-section hidden space-y-4 fade-up">
        <!-- SUBNAV PILL -->
        <div class="bg-white dark:bg-slate-800 rounded-2xl shadow-sm border border-slate-100 dark:border-slate-700">
          <div class="subnav-wrap">
            <button type="button" onclick="switchSubTugas('pickup-tugas')" id="sub-tugas-pickup-tugas" class="snpill active"><i class="fa-solid fa-hand-holding-hand text-blue-600 dark:text-blue-400"></i><span>Pickup Tugas</span></button>
            <button type="button" onclick="switchSubTugas('tugas-saya')" id="sub-tugas-tugas-saya" class="snpill"><i class="fa-solid fa-user-gear text-indigo-600 dark:text-indigo-400"></i><span>Tugas Saya</span></button>
            <button type="button" onclick="switchSubTugas('return-tugas')" id="sub-tugas-return-tugas" class="snpill"><i class="fa-solid fa-rotate-left text-rose-500"></i><span>Return</span></button>
            <button type="button" onclick="switchSubTugas('riwayat-tugas')" id="sub-tugas-riwayat-tugas" class="snpill"><i class="fa-solid fa-clock-rotate-left text-slate-500"></i><span>Riwayat</span></button>
          </div>
        </div>

        <!-- PICKUP TUGAS -->
        <div id="sub-content-pickup-tugas" class="sub-tugas-content space-y-3">
          <div class="bg-white dark:bg-slate-800 rounded-3xl p-5 shadow-sm border border-slate-100 dark:border-slate-700 space-y-4">
            <div class="border-b border-slate-100 dark:border-slate-700 pb-3">
              <h2 class="text-base font-extrabold text-slate-900 dark:text-white flex items-center gap-2"><i class="fa-solid fa-bell text-blue-600"></i>Tiket Release</h2>
              <p class="text-xs text-slate-400">Cari & pickup WO yang sudah dirilis admin</p>
            </div>
            <div class="relative">
              <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400"><i class="fa-solid fa-magnifying-glass text-sm"></i></div>
              <input type="text" id="pickup-search" oninput="filterPickupList()" placeholder="Cari nama pelanggan / No. Tiket..." class="w-full pl-10 pr-4 py-3 bg-slate-50 dark:bg-slate-700/50 border border-slate-200 dark:border-slate-600 rounded-2xl text-sm font-medium text-slate-800 dark:text-slate-100 focus:outline-none focus:border-blue-600 focus:ring-2 focus:ring-blue-600/20 transition-all">
            </div>
            <div class="space-y-3" id="pickup-list">
              <div class="text-center text-xs text-slate-400 py-6">Memuat daftar tiket...</div>
            </div>
          </div>
        </div>

        <!-- TUGAS SAYA -->
        <div id="sub-content-tugas-saya" class="sub-tugas-content hidden space-y-4">
          <div id="view-tugas-saya-list" class="bg-white dark:bg-slate-800 rounded-3xl p-5 shadow-sm border border-slate-100 dark:border-slate-700 space-y-3">
            <div class="border-b border-slate-100 dark:border-slate-700 pb-3">
              <h2 class="text-base font-extrabold text-slate-900 dark:text-white flex items-center gap-2"><i class="fa-solid fa-user-gear text-blue-600"></i>Daftar Tugas Saya</h2>
              <p class="text-xs text-slate-400">WO yang sudah Anda pickup dan siap dikerjakan</p>
            </div>
            <div id="my-task-list"><p class="text-xs text-slate-400 text-center py-6">Belum ada tugas. Pickup WO terlebih dahulu.</p></div>
          </div>

          <!-- FORM INSTALASI -->
          <div id="form-work-instalasi" class="hidden bg-white dark:bg-slate-800 rounded-3xl p-5 lg:p-6 shadow-sm border border-slate-100 dark:border-slate-700 space-y-5">
            <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-700 pb-3">
              <div><h2 class="text-base font-extrabold text-slate-900 dark:text-white">Pelaporan Instalasi Baru</h2><p class="text-xs text-slate-400" id="instalasi-wo-info">WO ID: --</p></div>
              <button type="button" onclick="showCancelWOModal('instalasi')" class="px-3 py-1.5 bg-rose-100 hover:bg-rose-200 dark:bg-rose-950/50 text-rose-600 dark:text-rose-400 rounded-xl text-xs font-bold transition-all flex items-center gap-1"><i class="fa-solid fa-ban text-xs"></i>Cancel</button>
            </div>
            <div class="grid grid-cols-2 gap-2">
              <div id="step-btn-1" class="step-indicator active p-2.5 rounded-2xl border text-center cursor-pointer transition-all"><p class="text-[10px] font-bold uppercase">STEP 1</p><p class="text-xs font-black">Installation & ODP</p></div>
              <div id="step-btn-2" class="step-indicator p-2.5 rounded-2xl border border-slate-200 dark:border-slate-700 text-slate-400 text-center cursor-pointer transition-all"><p class="text-[10px] font-bold uppercase">STEP 2</p><p class="text-xs font-black">Evidence Work Done</p></div>
            </div>

            <!-- STEP 1 -->
            <div id="instalasi-step-1-content" class="space-y-4">
              <div class="space-y-2">
                <label class="block text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Titik Koordinat Pelanggan <span class="text-rose-500">*</span></label>
                <button type="button" onclick="getTaskLocation('instalasi')" class="w-full py-2.5 px-4 bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs rounded-xl transition-all shadow-md flex items-center justify-center gap-2"><i class="fa-solid fa-location-crosshairs"></i>GET LOCATION</button>
                <p id="instalasi-coord-status" class="text-[11px] text-slate-400 italic">Koordinat belum terdeteksi.</p>
                <div id="instalasi-map" class="hidden w-full h-44 rounded-2xl border border-slate-200 dark:border-slate-600 z-0"></div>
                <div id="instalasi-odp-nearby" class="hidden bg-blue-50 dark:bg-blue-950/30 border border-blue-100 dark:border-blue-900 rounded-2xl p-3 space-y-1">
                  <p class="text-xs font-extrabold text-blue-700 dark:text-blue-300 flex items-center gap-1.5"><i class="fa-solid fa-tower-broadcast"></i>ODP Terdekat (radius 150m):</p>
                  <div id="instalasi-odp-list" class="space-y-1"></div>
                </div>
              </div>
              <!-- FOTO GRID STEP 1 — COMPACT 1+2x2 -->
              <div>
                <p class="text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-2">Foto Dokumentasi Step 1 <span class="text-rose-500">*</span></p>
                <div class="grid grid-cols-3 gap-2">
                  <!-- FOTO BESAR (briefing awal) -->
                  <div class="cam-cell col-span-3 sm:col-span-1">
                    <label>Briefing Awal</label>
                    <div class="cam-box" id="cam-box-s1f1" onclick="triggerCam('s1f1')" style="aspect-ratio:1;min-height:90px;">
                      <div class="cam-ph"><i class="fa-solid fa-camera"></i><span>Foto</span></div>
                      <img id="cam-img-s1f1" alt="">
                    </div>
                    <input type="file" id="cam-s1f1" accept="image/*" capture="user" class="hidden" onchange="onCamChange(event,'s1f1')">
                  </div>
                  <div class="cam-cell col-span-3 sm:col-span-2 grid grid-cols-2 gap-2">
                    <div class="cam-cell">
                      <label>ODP Tertutup</label>
                      <div class="cam-box" id="cam-box-s1f2" onclick="triggerCam('s1f2')" style="aspect-ratio:1;min-height:90px;">
                        <div class="cam-ph"><i class="fa-solid fa-camera"></i><span>Foto</span></div><img id="cam-img-s1f2" alt="">
                      </div>
                      <input type="file" id="cam-s1f2" accept="image/*" capture="environment" class="hidden" onchange="onCamChange(event,'s1f2')">
                    </div>
                    <div class="cam-cell">
                      <label>ODP Terbuka</label>
                      <div class="cam-box" id="cam-box-s1f3" onclick="triggerCam('s1f3')" style="aspect-ratio:1;min-height:90px;">
                        <div class="cam-ph"><i class="fa-solid fa-camera"></i><span>Foto</span></div><img id="cam-img-s1f3" alt="">
                      </div>
                      <input type="file" id="cam-s1f3" accept="image/*" capture="environment" class="hidden" onchange="onCamChange(event,'s1f3')">
                    </div>
                    <div class="cam-cell">
                      <label>Label Pelanggan</label>
                      <div class="cam-box" id="cam-box-s1f4" onclick="triggerCam('s1f4')" style="aspect-ratio:1;min-height:90px;">
                        <div class="cam-ph"><i class="fa-solid fa-camera"></i><span>Foto</span></div><img id="cam-img-s1f4" alt="">
                      </div>
                      <input type="file" id="cam-s1f4" accept="image/*" capture="environment" class="hidden" onchange="onCamChange(event,'s1f4')">
                    </div>
                    <div class="cam-cell">
                      <label>Ban Kabel Awal</label>
                      <div class="cam-box" id="cam-box-s1f5" onclick="triggerCam('s1f5')" style="aspect-ratio:1;min-height:90px;">
                        <div class="cam-ph"><i class="fa-solid fa-camera"></i><span>Foto</span></div><img id="cam-img-s1f5" alt="">
                      </div>
                      <input type="file" id="cam-s1f5" accept="image/*" capture="environment" class="hidden" onchange="onCamChange(event,'s1f5')">
                    </div>
                  </div>
                </div>
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div><label class="block text-xs font-bold text-slate-500 uppercase mb-1">Pilih ODP <span class="text-rose-500">*</span></label><select id="select-odp-instalasi" required class="w-full p-2.5 bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-xl text-xs font-medium"><option value="" disabled selected>-- Dapatkan lokasi dulu --</option></select><p class="text-[10px] text-slate-400 mt-1">ODP dalam radius 150m</p></div>
                <div><label class="block text-xs font-bold text-slate-500 uppercase mb-1">Port ODP <span class="text-rose-500">*</span></label><input type="number" id="port-odp-instalasi" required placeholder="Contoh: 4" class="w-full p-2.5 bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-xl text-xs"></div>
              </div>
              <button type="button" onclick="goToInstalasiStep2()" class="w-full py-3 bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs rounded-2xl shadow-md transition-all flex items-center justify-center gap-2"><span>Berikutnya (STEP 2)</span><i class="fa-solid fa-arrow-right"></i></button>
            </div>

            <!-- STEP 2 -->
            <div id="instalasi-step-2-content" class="hidden space-y-4">
              <!-- FOTO GRID STEP 2 -->
              <div>
                <p class="text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-2">Evidence Work Done <span class="text-rose-500">*</span></p>
                <div class="grid grid-cols-3 gap-2">
                  <div class="cam-cell">
                    <label>Rumah Pelanggan</label>
                    <div class="cam-box" id="cam-box-s2f1" onclick="triggerCam('s2f1')" style="aspect-ratio:1;min-height:80px;">
                      <div class="cam-ph"><i class="fa-solid fa-camera"></i><span>Foto</span></div><img id="cam-img-s2f1" alt="">
                    </div>
                    <input type="file" id="cam-s2f1" accept="image/*" capture="environment" class="hidden" onchange="onCamChange(event,'s2f1')">
                  </div>
                  <div class="cam-cell">
                    <label>SN ONT</label>
                    <div class="cam-box" id="cam-box-s2f2" onclick="triggerCam('s2f2')" style="aspect-ratio:1;min-height:80px;">
                      <div class="cam-ph"><i class="fa-solid fa-camera"></i><span>Foto</span></div><img id="cam-img-s2f2" alt="">
                    </div>
                    <input type="file" id="cam-s2f2" accept="image/*" capture="environment" class="hidden" onchange="onCamChange(event,'s2f2')">
                  </div>
                  <div class="cam-cell">
                    <label>Kabel Akhir</label>
                    <div class="cam-box" id="cam-box-s2f3" onclick="triggerCam('s2f3')" style="aspect-ratio:1;min-height:80px;">
                      <div class="cam-ph"><i class="fa-solid fa-camera"></i><span>Foto</span></div><img id="cam-img-s2f3" alt="">
                    </div>
                    <input type="file" id="cam-s2f3" accept="image/*" capture="environment" class="hidden" onchange="onCamChange(event,'s2f3')">
                  </div>
                  <div class="cam-cell">
                    <label>ONT Terpasang</label>
                    <div class="cam-box" id="cam-box-s2f4" onclick="triggerCam('s2f4')" style="aspect-ratio:1;min-height:80px;">
                      <div class="cam-ph"><i class="fa-solid fa-camera"></i><span>Foto</span></div><img id="cam-img-s2f4" alt="">
                    </div>
                    <input type="file" id="cam-s2f4" accept="image/*" capture="environment" class="hidden" onchange="onCamChange(event,'s2f4')">
                  </div>
                  <div class="cam-cell">
                    <label>Speed Test</label>
                    <div class="cam-box" id="cam-box-s2f5" onclick="triggerCam('s2f5')" style="aspect-ratio:1;min-height:80px;">
                      <div class="cam-ph"><i class="fa-solid fa-camera"></i><span>Foto</span></div><img id="cam-img-s2f5" alt="">
                    </div>
                    <input type="file" id="cam-s2f5" accept="image/*" capture="environment" class="hidden" onchange="onCamChange(event,'s2f5')">
                  </div>
                  <div class="cam-cell">
                    <label>Briefing Akhir</label>
                    <div class="cam-box" id="cam-box-s2f6" onclick="triggerCam('s2f6')" style="aspect-ratio:1;min-height:80px;">
                      <div class="cam-ph"><i class="fa-solid fa-camera"></i><span>Foto</span></div><img id="cam-img-s2f6" alt="">
                    </div>
                    <input type="file" id="cam-s2f6" accept="image/*" capture="user" class="hidden" onchange="onCamChange(event,'s2f6')">
                  </div>
                </div>
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div><label class="block text-xs font-bold text-slate-500 uppercase mb-1">SN ONT <span class="text-rose-500">*</span></label><select id="sn-ont-select" required class="w-full p-2.5 bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-xl text-xs font-medium"><option value="" disabled selected>-- Pilih SN ONT --</option></select></div>
                <div><label class="block text-xs font-bold text-slate-500 uppercase mb-1">SN Kabel <span class="text-rose-500">*</span></label><select id="sn-kabel-select" required class="w-full p-2.5 bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-xl text-xs font-medium"><option value="" disabled selected>-- Pilih SN Kabel --</option></select></div>
              </div>
              <!-- Username PPPOE, Password, Status Koneksi -->
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div><label class="block text-xs font-bold text-slate-500 uppercase mb-1">Username PPPOE <span class="text-rose-500">*</span></label><input type="text" id="instalasi-username-pppoe" placeholder="user@isp" class="w-full p-2.5 bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-xl text-xs font-medium"></div>
                <div><label class="block text-xs font-bold text-slate-500 uppercase mb-1">Password PPPOE <span class="text-rose-500">*</span></label><input type="text" id="instalasi-password-pppoe" placeholder="password" class="w-full p-2.5 bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-xl text-xs font-medium"></div>
              </div>
              <div class="grid grid-cols-2 gap-3">
                <div><label class="block text-xs font-bold text-slate-500 uppercase mb-1">Status Koneksi</label>
                  <select id="instalasi-status-koneksi" class="w-full p-2.5 bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-xl text-xs font-bold">
                    <option value="Rumahan">Rumahan</option><option value="Reseller">Reseller</option>
                  </select>
                </div>
                <div><label class="block text-xs font-bold text-slate-500 uppercase mb-1">Panjang Kabel (meter)</label><input type="number" id="instalasi-panjang-kabel" placeholder="0" min="0" class="w-full p-2.5 bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-xl text-xs font-medium"></div>
              </div>
              <!-- PROVISIONING -->
              <div class="bg-indigo-50 dark:bg-indigo-950/30 border border-indigo-200 dark:border-indigo-800 rounded-2xl p-4 space-y-3">
                <p class="text-xs font-extrabold text-indigo-700 dark:text-indigo-300 flex items-center gap-2"><i class="fa-solid fa-server"></i>Request Registrasi Provisioning</p>
                <p class="text-[11px] text-slate-500 dark:text-slate-400">Notifikasi terkirim ke Admin untuk proses aktivasi di sistem provisioning.</p>
                <div id="provisioning-status" class="hidden items-center gap-3 p-3 rounded-xl border"></div>
                <button type="button" id="btn-request-provisioning" onclick="requestProvisioning()" class="w-full py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-xs rounded-xl transition-all shadow-md flex items-center justify-center gap-2"><i class="fa-solid fa-paper-plane"></i>Kirim Request Registrasi</button>
              </div>
              <div class="flex items-center gap-2 pt-2">
                <button type="button" onclick="goToInstalasiStep1()" class="w-1/3 py-3 bg-slate-100 dark:bg-slate-700 text-slate-700 dark:text-slate-200 font-bold text-xs rounded-2xl transition-all">Kembali</button>
                <button type="button" onclick="submitWorkInstalasi()" class="w-2/3 py-3 bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs rounded-2xl shadow-md transition-all flex items-center justify-center gap-2"><i class="fa-solid fa-check-circle"></i>Submit & Aktifkan</button>
              </div>
            </div>
          </div>

          <!-- FORM MAINTENANCE -->
          <div id="form-work-maintenance" class="hidden bg-white dark:bg-slate-800 rounded-3xl p-5 lg:p-6 shadow-sm border border-slate-100 dark:border-slate-700 space-y-4">
            <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-700 pb-3">
              <div><h2 class="text-base font-extrabold text-slate-900 dark:text-white">Pelaporan Maintenance</h2><p class="text-xs text-slate-400" id="maint-wo-info">WO ID: --</p></div>
              <button type="button" onclick="showCancelWOModal('maintenance')" class="px-3 py-1.5 bg-rose-100 hover:bg-rose-200 dark:bg-rose-950/50 text-rose-600 dark:text-rose-400 rounded-xl text-xs font-bold transition-all">Cancel</button>
            </div>
            <div class="space-y-2">
              <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider">Koordinat Lokasi <span class="text-rose-500">*</span></label>
              <button type="button" onclick="getTaskLocation('maintenance')" class="w-full py-2.5 px-4 bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs rounded-xl transition-all shadow-md flex items-center justify-center gap-2"><i class="fa-solid fa-location-crosshairs"></i>GET LOCATION</button>
              <p id="maintenance-coord-status" class="text-[11px] text-slate-400 italic">Koordinat belum terdeteksi.</p>
              <div id="maintenance-map" class="hidden w-full h-44 rounded-2xl border border-slate-200 dark:border-slate-600 z-0"></div>
            </div>
            <!-- FOTO MAINTENANCE GRID -->
            <div>
              <p class="text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-2">Foto Dokumentasi <span class="text-rose-500">*</span></p>
              <div class="grid grid-cols-3 gap-2">
                <div class="cam-cell">
                  <label>Teknisi Selfie</label>
                  <div class="cam-box" id="cam-box-mf1" onclick="triggerCam('mf1')" style="aspect-ratio:1;min-height:80px;">
                    <div class="cam-ph"><i class="fa-solid fa-camera"></i><span>Foto</span></div><img id="cam-img-mf1" alt="">
                  </div>
                  <input type="file" id="cam-mf1" accept="image/*" capture="user" class="hidden" onchange="onCamChange(event,'mf1')">
                </div>
                <div class="cam-cell">
                  <label>Sebelum</label>
                  <div class="cam-box" id="cam-box-mf2" onclick="triggerCam('mf2')" style="aspect-ratio:1;min-height:80px;">
                    <div class="cam-ph"><i class="fa-solid fa-camera"></i><span>Foto</span></div><img id="cam-img-mf2" alt="">
                  </div>
                  <input type="file" id="cam-mf2" accept="image/*" capture="environment" class="hidden" onchange="onCamChange(event,'mf2')">
                </div>
                <div class="cam-cell">
                  <label>Sesudah</label>
                  <div class="cam-box" id="cam-box-mf3" onclick="triggerCam('mf3')" style="aspect-ratio:1;min-height:80px;">
                    <div class="cam-ph"><i class="fa-solid fa-camera"></i><span>Foto</span></div><img id="cam-img-mf3" alt="">
                  </div>
                  <input type="file" id="cam-mf3" accept="image/*" capture="environment" class="hidden" onchange="onCamChange(event,'mf3')">
                </div>
              </div>
            </div>
            <!-- Tambah panjang kabel maintenance -->
            <div><label class="block text-xs font-bold text-slate-500 uppercase mb-1">Panjang Kabel Terpakai (meter)</label><input type="number" id="maint-panjang-kabel" placeholder="0" min="0" class="w-full p-2.5 bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-xl text-xs font-medium"></div>
            <button type="button" onclick="submitWorkMaintenance()" class="w-full py-3 bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs rounded-2xl shadow-md transition-all flex items-center justify-center gap-2"><i class="fa-solid fa-paper-plane"></i>Submit Maintenance</button>
          </div>

          <!-- ===== FORM KERJA NOC (Maintenance) ===== -->
          <div id="form-work-noc" class="hidden bg-white dark:bg-slate-800 rounded-3xl p-5 lg:p-6 shadow-sm border border-slate-100 dark:border-slate-700 space-y-4">
            <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-700 pb-3">
              <div><h2 class="text-base font-extrabold text-slate-900 dark:text-white flex items-center gap-2"><i class="fa-solid fa-headset text-violet-600"></i>Penanganan NOC</h2><p class="text-xs text-slate-400" id="noc-wo-info">WO ID: --</p></div>
            </div>
            <!-- Info Kendala dari CS -->
            <div class="bg-amber-50 dark:bg-amber-950/30 border border-amber-200 dark:border-amber-800 rounded-2xl p-3 space-y-1">
              <p class="text-[10px] font-extrabold text-amber-700 dark:text-amber-300 uppercase tracking-wider flex items-center gap-1.5"><i class="fa-solid fa-triangle-exclamation"></i>Kendala dari CS</p>
              <p class="text-xs text-slate-700 dark:text-slate-200" id="noc-kendala-info">—</p>
            </div>
            <!-- Form Diagnosa & Penanganan -->
            <div class="space-y-3">
              <div><label class="block text-xs font-bold text-slate-500 uppercase mb-1">Diagnosa <span class="text-rose-500">*</span></label><textarea id="noc-diagnosa" rows="3" placeholder="Tuliskan hasil diagnosa dari sisi NOC..." class="w-full p-2.5 bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-xl text-xs font-medium resize-none"></textarea></div>
              <div><label class="block text-xs font-bold text-slate-500 uppercase mb-1">Penanganan <span class="text-rose-500">*</span></label><textarea id="noc-penanganan" rows="3" placeholder="Langkah yang sudah dilakukan dari sisi NOC..." class="w-full p-2.5 bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-xl text-xs font-medium resize-none"></textarea></div>
            </div>
            <!-- Opsional: SN ONT / Kabel -->
            <div class="bg-slate-50 dark:bg-slate-700/40 border border-slate-200 dark:border-slate-600 rounded-2xl p-3 space-y-3">
              <p class="text-xs font-extrabold text-slate-600 dark:text-slate-300 flex items-center gap-1.5"><i class="fa-solid fa-box-archive text-blue-500"></i>Perangkat Diganti (Opsional)</p>
              <p class="text-[11px] text-slate-400">Isi hanya jika ada penggantian ONT atau kabel.</p>
              <div class="grid grid-cols-2 gap-3">
                <div><label class="block text-xs font-bold text-slate-500 uppercase mb-1">SN ONT</label><select id="noc-sn-ont" class="w-full p-2.5 bg-white dark:bg-slate-600 border border-slate-200 dark:border-slate-600 rounded-xl text-xs font-medium"><option value="">-- Tidak ada --</option></select></div>
                <div><label class="block text-xs font-bold text-slate-500 uppercase mb-1">SN Kabel</label><select id="noc-sn-kabel" class="w-full p-2.5 bg-white dark:bg-slate-600 border border-slate-200 dark:border-slate-600 rounded-xl text-xs font-medium"><option value="">-- Tidak ada --</option></select></div>
              </div>
            </div>
            <!-- Tombol aksi -->
            <div class="grid grid-cols-2 gap-3 pt-1">
              <button type="button" onclick="nocReleaseToTeknisi()" class="py-3 bg-amber-500 hover:bg-amber-600 text-white font-bold text-xs rounded-2xl shadow-md transition-all flex items-center justify-center gap-2 active:scale-95"><i class="fa-solid fa-arrow-right-from-bracket"></i>Release ke Teknisi</button>
              <button type="button" onclick="submitWorkNOC()" class="py-3 bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs rounded-2xl shadow-md transition-all flex items-center justify-center gap-2 active:scale-95"><i class="fa-solid fa-circle-check"></i>Selesai (NOC)</button>
            </div>
          </div>

          <!-- ===== FORM KERJA PERLUASAN RESELLER (Teknisi) ===== -->
          <div id="form-work-perluasan" class="hidden bg-white dark:bg-slate-800 rounded-3xl p-5 lg:p-6 shadow-sm border border-slate-100 dark:border-slate-700 space-y-5">
            <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-700 pb-3">
              <div><h2 class="text-base font-extrabold text-slate-900 dark:text-white">Pelaporan Perluasan Reseller</h2><p class="text-xs text-slate-400" id="perluasan-wo-info">WO ID: --</p></div>
              <button type="button" onclick="showCancelWOModal('perluasan')" class="px-3 py-1.5 bg-rose-100 hover:bg-rose-200 dark:bg-rose-950/50 text-rose-600 dark:text-rose-400 rounded-xl text-xs font-bold">Cancel</button>
            </div>
            <!-- Koordinat -->
            <div class="space-y-2">
              <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider">Titik Koordinat <span class="text-rose-500">*</span></label>
              <button type="button" onclick="getTaskLocation('perluasan')" class="w-full py-2.5 px-4 bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs rounded-xl transition-all shadow-md flex items-center justify-center gap-2"><i class="fa-solid fa-location-crosshairs"></i>GET LOCATION</button>
              <p id="perluasan-coord-status" class="text-[11px] text-slate-400 italic">Koordinat belum terdeteksi.</p>
              <div id="perluasan-map" class="hidden w-full h-44 rounded-2xl border border-slate-200 dark:border-slate-600 z-0"></div>
            </div>
            <!-- FOTO GRID — ODP opsional -->
            <div>
              <p class="text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-2">Foto Dokumentasi</p>
              <div class="grid grid-cols-3 gap-2">
                <div class="cam-cell col-span-3">
                  <label>ODP (Opsional)</label>
                  <div class="cam-box" id="cam-box-pf1" onclick="triggerCam('pf1')" style="aspect-ratio:16/9;min-height:80px;">
                    <div class="cam-ph"><i class="fa-solid fa-camera"></i><span>Foto</span></div><img id="cam-img-pf1" alt="">
                  </div>
                  <input type="file" id="cam-pf1" accept="image/*" capture="environment" class="hidden" onchange="onCamChange(event,'pf1')">
                </div>
                <div class="cam-cell"><label>Lokasi Instalasi</label>
                  <div class="cam-box" id="cam-box-pf2" onclick="triggerCam('pf2')" style="aspect-ratio:1;min-height:80px;">
                    <div class="cam-ph"><i class="fa-solid fa-camera"></i><span>Foto</span></div><img id="cam-img-pf2" alt="">
                  </div>
                  <input type="file" id="cam-pf2" accept="image/*" capture="environment" class="hidden" onchange="onCamChange(event,'pf2')">
                </div>
                <div class="cam-cell"><label>SN Access Point</label>
                  <div class="cam-box" id="cam-box-pf3" onclick="triggerCam('pf3')" style="aspect-ratio:1;min-height:80px;">
                    <div class="cam-ph"><i class="fa-solid fa-camera"></i><span>Foto</span></div><img id="cam-img-pf3" alt="">
                  </div>
                  <input type="file" id="cam-pf3" accept="image/*" capture="environment" class="hidden" onchange="onCamChange(event,'pf3')">
                </div>
                <div class="cam-cell"><label>Perangkat Terpasang</label>
                  <div class="cam-box" id="cam-box-pf4" onclick="triggerCam('pf4')" style="aspect-ratio:1;min-height:80px;">
                    <div class="cam-ph"><i class="fa-solid fa-camera"></i><span>Foto</span></div><img id="cam-img-pf4" alt="">
                  </div>
                  <input type="file" id="cam-pf4" accept="image/*" capture="environment" class="hidden" onchange="onCamChange(event,'pf4')">
                </div>
                <div class="cam-cell col-span-3 sm:col-span-1"><label>Speed Test</label>
                  <div class="cam-box" id="cam-box-pf5" onclick="triggerCam('pf5')" style="aspect-ratio:1;min-height:80px;">
                    <div class="cam-ph"><i class="fa-solid fa-camera"></i><span>Foto</span></div><img id="cam-img-pf5" alt="">
                  </div>
                  <input type="file" id="cam-pf5" accept="image/*" capture="environment" class="hidden" onchange="onCamChange(event,'pf5')">
                </div>
              </div>
            </div>
            <!-- SN Perangkat -->
            <div class="grid grid-cols-2 gap-3">
              <div><label class="block text-xs font-bold text-slate-500 uppercase mb-1">SN ONT / Access Point <span class="text-rose-500">*</span></label><select id="perluasan-sn-ont" required class="w-full p-2.5 bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-xl text-xs font-medium"><option value="" disabled selected>-- Pilih SN --</option></select></div>
              <div><label class="block text-xs font-bold text-slate-500 uppercase mb-1">SN Kabel</label>
                <select id="perluasan-sn-kabel" class="w-full p-2.5 bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-xl text-xs font-medium">
                  <option value="">-- Tidak ada --</option>
                </select>
              </div>
            </div>
            <div><label class="block text-xs font-bold text-slate-500 uppercase mb-1">Panjang Kabel Terpakai (meter)</label><input type="number" id="perluasan-panjang-kabel" placeholder="0" min="0" class="w-full p-2.5 bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-xl text-xs font-medium"></div>
            <div><label class="block text-xs font-bold text-slate-500 uppercase mb-1">Catatan</label><textarea id="perluasan-catatan" rows="2" placeholder="Catatan tambahan..." class="w-full p-2.5 bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-xl text-xs font-medium resize-none"></textarea></div>
            <button type="button" onclick="submitWorkPerluasan()" class="w-full py-3 bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs rounded-2xl shadow-md transition-all flex items-center justify-center gap-2"><i class="fa-solid fa-check-circle"></i>Submit Perluasan</button>
          </div>
        </div>

        <!-- RETURN TUGAS -->
        <div id="sub-content-return-tugas" class="sub-tugas-content hidden space-y-3">
          <div class="bg-white dark:bg-slate-800 rounded-3xl p-5 shadow-sm border border-slate-100 dark:border-slate-700 space-y-4">
            <div class="border-b border-slate-100 dark:border-slate-700 pb-3"><h2 class="text-base font-extrabold text-slate-900 dark:text-white flex items-center gap-2"><i class="fa-solid fa-rotate-left text-rose-500"></i>Return Tugas</h2></div>
            <div class="space-y-3">
              <div><label class="block text-xs font-bold text-slate-500 uppercase">Pilih WO <span class="text-rose-500">*</span></label><select id="return-wo-select" class="w-full p-3 bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-2xl text-xs font-bold mt-1"><option>WO-202608-010 - Bpk. Hendra Wijaya</option><option>WO-202608-011 - Ibu Siska Pratama</option></select></div>
              <div><label class="block text-xs font-bold text-slate-500 uppercase">Alasan <span class="text-rose-500">*</span></label><textarea id="return-wo-reason" rows="3" placeholder="Pelanggan tidak ada di rumah..." class="w-full p-3 bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-2xl text-xs font-medium resize-none mt-1"></textarea></div>
              <button type="button" onclick="executeReturnTask()" class="w-full py-3 bg-rose-600 hover:bg-rose-700 text-white font-bold text-xs rounded-2xl shadow-md transition-all flex items-center justify-center gap-2"><i class="fa-solid fa-rotate-left"></i>Kembalikan WO</button>
            </div>
          </div>
        </div>

        <!-- RIWAYAT -->
        <div id="sub-content-riwayat-tugas" class="sub-tugas-content hidden space-y-3">
          <div class="bg-white dark:bg-slate-800 rounded-3xl p-5 shadow-sm border border-slate-100 dark:border-slate-700 space-y-4">
            <div class="border-b border-slate-100 dark:border-slate-700 pb-3"><h2 class="text-base font-extrabold text-slate-900 dark:text-white flex items-center gap-2"><i class="fa-solid fa-clock-rotate-left text-blue-600"></i>Riwayat Tugas</h2><p class="text-xs text-slate-400">Tugas yang sudah Anda selesaikan</p></div>
            <div id="riwayat-tugas-list" class="space-y-2">
              <p class="text-xs text-slate-400 text-center py-6">Belum ada tugas selesai.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- ===== NOC ===== -->
      <div id="section-noc" class="main-section hidden space-y-4 fade-up">
        <div class="bg-white dark:bg-slate-800 rounded-2xl shadow-sm border border-slate-100 dark:border-slate-700">
          <div class="subnav-wrap">
            <button type="button" onclick="switchSubNOC('tugas-noc')" id="sub-noc-tugas-noc" class="snpill active"><i class="fa-solid fa-headset text-violet-600 dark:text-violet-400"></i><span>Tugas Saya</span></button>
            <button type="button" onclick="switchSubNOC('riwayat-noc')" id="sub-noc-riwayat-noc" class="snpill"><i class="fa-solid fa-clock-rotate-left text-slate-500"></i><span>Riwayat</span></button>
          </div>
        </div>

        <!-- TUGAS NOC -->
        <div id="sub-content-tugas-noc" class="sub-noc-content space-y-3">
          <div id="view-noc-list" class="space-y-3">
            <div class="bg-white dark:bg-slate-800 rounded-3xl p-5 shadow-sm border border-slate-100 dark:border-slate-700 space-y-3">
              <div class="border-b border-slate-100 dark:border-slate-700 pb-3 flex items-center justify-between">
                <div><h2 class="text-base font-extrabold text-slate-900 dark:text-white flex items-center gap-2"><i class="fa-solid fa-headset text-violet-600"></i>Tugas Masuk NOC</h2><p class="text-xs text-slate-400">WO Maintenance yang perlu diagnosa</p></div>
                <button type="button" onclick="loadNOCTasks()" class="px-2.5 py-1 bg-slate-100 dark:bg-slate-700 hover:bg-slate-200 text-slate-600 dark:text-slate-300 rounded-lg text-[10px] font-bold flex items-center gap-1"><i class="fa-solid fa-rotate-right text-[10px]"></i>Refresh</button>
              </div>
              <div id="noc-task-list" class="space-y-2">
                <p class="text-xs text-slate-400 text-center py-6">Memuat tugas NOC...</p>
              </div>
            </div>
          </div>
          <!-- Form kerjakan NOC -->
          <div id="view-noc-form" class="hidden space-y-3">
            <div class="bg-white dark:bg-slate-800 rounded-3xl p-5 lg:p-6 shadow-sm border border-slate-100 dark:border-slate-700 space-y-4">
              <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-700 pb-3">
                <div><h2 class="text-base font-extrabold text-slate-900 dark:text-white flex items-center gap-2"><i class="fa-solid fa-headset text-violet-600"></i>Penanganan NOC</h2><p class="text-xs text-slate-400" id="noc-wo-info-form">WO ID: --</p></div>
              </div>
              <div class="bg-amber-50 dark:bg-amber-950/30 border border-amber-200 dark:border-amber-800 rounded-2xl p-3 space-y-1">
                <p class="text-[10px] font-extrabold text-amber-700 dark:text-amber-300 uppercase tracking-wider flex items-center gap-1.5"><i class="fa-solid fa-triangle-exclamation"></i>Kendala dari CS</p>
                <p class="text-xs text-slate-700 dark:text-slate-200" id="noc-kendala-info-form">—</p>
              </div>
              <div><label class="block text-xs font-bold text-slate-500 uppercase mb-1">Diagnosa <span class="text-rose-500">*</span></label><textarea id="noc-diagnosa-form" rows="3" placeholder="Hasil diagnosa dari sisi NOC..." class="w-full p-2.5 bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-xl text-xs font-medium resize-none"></textarea></div>
              <div><label class="block text-xs font-bold text-slate-500 uppercase mb-1">Penanganan <span class="text-rose-500">*</span></label><textarea id="noc-penanganan-form" rows="3" placeholder="Langkah yang sudah dilakukan..." class="w-full p-2.5 bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-xl text-xs font-medium resize-none"></textarea></div>
              <div class="bg-slate-50 dark:bg-slate-700/40 border border-slate-200 dark:border-slate-600 rounded-2xl p-3 space-y-3">
                <p class="text-xs font-extrabold text-slate-600 dark:text-slate-300 flex items-center gap-1.5"><i class="fa-solid fa-box-archive text-blue-500"></i>Perangkat Diganti (Opsional)</p>
                <div class="grid grid-cols-2 gap-3">
                  <div><label class="block text-xs font-bold text-slate-500 uppercase mb-1">SN ONT</label><select id="noc-sn-ont-form" class="w-full p-2.5 bg-white dark:bg-slate-600 border border-slate-200 dark:border-slate-600 rounded-xl text-xs font-medium"><option value="">-- Tidak ada --</option></select></div>
                  <div><label class="block text-xs font-bold text-slate-500 uppercase mb-1">SN Kabel</label><select id="noc-sn-kabel-form" class="w-full p-2.5 bg-white dark:bg-slate-600 border border-slate-200 dark:border-slate-600 rounded-xl text-xs font-medium"><option value="">-- Tidak ada --</option></select></div>
                </div>
              </div>
              <div class="grid grid-cols-2 gap-3 pt-1">
                <button type="button" onclick="nocReleaseToTeknisi()" class="py-3 bg-amber-500 hover:bg-amber-600 text-white font-bold text-xs rounded-2xl shadow-md transition-all flex items-center justify-center gap-2 active:scale-95"><i class="fa-solid fa-arrow-right-from-bracket"></i>Release ke Teknisi</button>
                <button type="button" onclick="submitWorkNOC()" class="py-3 bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs rounded-2xl shadow-md transition-all flex items-center justify-center gap-2 active:scale-95"><i class="fa-solid fa-circle-check"></i>Selesai (NOC)</button>
              </div>
            </div>
          </div>
        </div>

        <!-- RIWAYAT NOC -->
        <div id="sub-content-riwayat-noc" class="sub-noc-content hidden space-y-3">
          <div class="bg-white dark:bg-slate-800 rounded-3xl p-5 shadow-sm border border-slate-100 dark:border-slate-700 space-y-4">
            <div class="border-b border-slate-100 dark:border-slate-700 pb-3"><h2 class="text-base font-extrabold text-slate-900 dark:text-white flex items-center gap-2"><i class="fa-solid fa-clock-rotate-left text-violet-600"></i>Riwayat Tugas NOC</h2></div>
            <div id="riwayat-noc-list" class="space-y-2"><p class="text-xs text-slate-400 text-center py-6">Belum ada riwayat.</p></div>
          </div>
        </div>
      </div>

      <!-- ===== MATERIAL ===== -->
      <div id="section-material" class="main-section hidden space-y-4 fade-up">
        <div class="bg-white dark:bg-slate-800 rounded-2xl shadow-sm border border-slate-100 dark:border-slate-700">
          <div class="subnav-wrap">
            <button type="button" onclick="switchSubMaterial('pickup-perangkat')" id="sub-mat-pickup-perangkat" class="snpill active"><i class="fa-solid fa-qrcode text-blue-600 dark:text-blue-400"></i><span>Pickup</span></button>
            <button type="button" onclick="switchSubMaterial('waiting-approval')" id="sub-mat-waiting-approval" class="snpill"><i class="fa-solid fa-hourglass-half text-amber-500"></i><span>Waiting</span></button>
            <button type="button" onclick="switchSubMaterial('list-perangkat-saya')" id="sub-mat-list-perangkat-saya" class="snpill"><i class="fa-solid fa-boxes-packing text-emerald-500"></i><span>List Saya</span></button>
            <button type="button" onclick="switchSubMaterial('send-perangkat')" id="sub-mat-send-perangkat" class="snpill"><i class="fa-solid fa-share-nodes text-indigo-500"></i><span>Send</span></button>
            <button type="button" onclick="switchSubMaterial('return-perangkat')" id="sub-mat-return-perangkat" class="snpill"><i class="fa-solid fa-warehouse text-rose-500"></i><span>Return</span></button>
          </div>
        </div>
        <div id="sub-mat-content-pickup-perangkat" class="sub-mat-content space-y-4">
          <div class="bg-white dark:bg-slate-800 rounded-3xl p-5 shadow-sm border border-slate-100 dark:border-slate-700 space-y-4">
            <div class="border-b border-slate-100 dark:border-slate-700 pb-3"><h2 class="text-base font-extrabold text-slate-900 dark:text-white flex items-center gap-2"><i class="fa-solid fa-barcode text-blue-600"></i>Scan & Pickup Material</h2><p class="text-xs text-slate-400">Scan barcode atau input SN perangkat dari gudang</p></div>
            <div id="sn-camera-wrap" class="hidden"><div class="camera-preview-wrap mb-2"><video id="sn-video" autoplay playsinline muted class="w-full h-40 object-cover"></video><div class="scan-line"></div></div></div>
            <div class="flex gap-2">
              <input type="text" id="scan-sn-input" placeholder="Scan barcode atau ketik SN..." class="flex-1 p-3 bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-2xl text-xs font-extrabold tracking-wider focus:outline-none focus:border-blue-600">
              <button type="button" onclick="toggleSNCamera()" id="btn-sn-cam" class="px-3 py-3 bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs rounded-2xl shadow-md transition-all shrink-0 flex items-center gap-1.5"><i class="fa-solid fa-camera"></i>Kamera</button>
              <button type="button" onclick="checkAndScanSN()" class="px-4 py-3 bg-slate-700 hover:bg-slate-800 text-white font-bold text-xs rounded-2xl shadow-md transition-all shrink-0"><i class="fa-solid fa-magnifying-glass"></i></button>
            </div>
            <div id="scan-result-card" class="hidden p-4 rounded-2xl border transition-all"><p id="scan-result-status" class="text-xs font-bold"></p><p id="scan-result-details" class="text-[11px] text-slate-500 dark:text-slate-400 mt-1"></p></div>
            <button type="button" id="btn-submit-pickup-mat" onclick="submitPickupMaterial()" class="hidden w-full py-3 bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs rounded-2xl shadow-md transition-all flex items-center justify-center gap-2"><i class="fa-solid fa-hand-holding-hand"></i>Minta Approval Pickup</button>
          </div>
        </div>
        <div id="sub-mat-content-waiting-approval" class="sub-mat-content hidden space-y-3">
          <div class="bg-white dark:bg-slate-800 rounded-3xl p-5 shadow-sm border border-slate-100 dark:border-slate-700 space-y-4">
            <div class="border-b border-slate-100 dark:border-slate-700 pb-3"><h2 class="text-base font-extrabold text-slate-900 dark:text-white flex items-center gap-2"><i class="fa-solid fa-hourglass-half text-amber-500"></i>Menunggu Approval Admin</h2></div>
            <div class="p-4 bg-amber-50 dark:bg-amber-950/30 rounded-2xl border border-amber-200 dark:border-amber-800 flex justify-between items-center">
              <div><p class="text-xs font-black text-slate-800 dark:text-slate-100">SN-ONT-99201 (Modem ZTE)</p><p class="text-[10px] text-slate-400">Waktu Pickup: Hari Ini, 08:30 WIB</p></div>
              <span class="px-2.5 py-1 rounded-full text-[10px] font-extrabold bg-amber-100 text-amber-700 dark:bg-amber-950 dark:text-amber-300 animate-pulse">Waiting</span>
            </div>
          </div>
        </div>
        <div id="sub-mat-content-list-perangkat-saya" class="sub-mat-content hidden space-y-3">
          <div class="bg-white dark:bg-slate-800 rounded-3xl p-5 shadow-sm border border-slate-100 dark:border-slate-700 space-y-4">
            <div class="border-b border-slate-100 dark:border-slate-700 pb-3"><h2 class="text-base font-extrabold text-slate-900 dark:text-white flex items-center gap-2"><i class="fa-solid fa-boxes-packing text-emerald-500"></i>List Perangkat Saya</h2></div>
            <div class="space-y-2">
              <div class="p-3.5 bg-slate-50 dark:bg-slate-700/40 rounded-2xl border border-slate-200 dark:border-slate-600 flex justify-between items-center"><div><p class="text-xs font-bold text-slate-800 dark:text-slate-100">SN-ONT-99202 (Huawei EG8145)</p><p class="text-[10px] text-emerald-600 font-semibold"><i class="fa-solid fa-check-circle mr-1"></i>Ready</p></div><span class="text-xs font-black text-slate-400">ONT</span></div>
              <div class="p-3.5 bg-slate-50 dark:bg-slate-700/40 rounded-2xl border border-slate-200 dark:border-slate-600 flex justify-between items-center"><div><p class="text-xs font-bold text-slate-800 dark:text-slate-100">KBL-150M-01 (Dropcore 150m)</p><p class="text-[10px] text-emerald-600 font-semibold"><i class="fa-solid fa-check-circle mr-1"></i>Ready</p></div><span class="text-xs font-black text-slate-400">KABEL</span></div>
            </div>
          </div>
        </div>
        <div id="sub-mat-content-send-perangkat" class="sub-mat-content hidden space-y-3">
          <div class="bg-white dark:bg-slate-800 rounded-3xl p-5 shadow-sm border border-slate-100 dark:border-slate-700 space-y-4">
            <div class="border-b border-slate-100 dark:border-slate-700 pb-3"><h2 class="text-base font-extrabold text-slate-900 dark:text-white flex items-center gap-2"><i class="fa-solid fa-share-nodes text-indigo-500"></i>Send Perangkat</h2></div>
            <div class="space-y-3">
              <div><label class="block text-xs font-bold text-slate-500 uppercase mb-1">Pilih Perangkat <span class="text-rose-500">*</span></label><select class="w-full p-3 bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-2xl text-xs font-bold"><option>SN-ONT-99202 (Huawei EG8145)</option><option>KBL-150M-01</option></select></div>
              <div><label class="block text-xs font-bold text-slate-500 uppercase mb-1">Transfer Ke <span class="text-rose-500">*</span></label><select class="w-full p-3 bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-2xl text-xs font-bold"><option>Teknisi 2</option><option>Teknisi 3</option><option>Teknisi 4</option></select></div>
              <button type="button" onclick="executeSendMaterial()" class="w-full py-3 bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-xs rounded-2xl shadow-md transition-all flex items-center justify-center gap-2"><i class="fa-solid fa-paper-plane"></i>Kirim (Butuh Approval)</button>
            </div>
          </div>
        </div>
        <div id="sub-mat-content-return-perangkat" class="sub-mat-content hidden space-y-3">
          <div class="bg-white dark:bg-slate-800 rounded-3xl p-5 shadow-sm border border-slate-100 dark:border-slate-700 space-y-4">
            <div class="border-b border-slate-100 dark:border-slate-700 pb-3"><h2 class="text-base font-extrabold text-slate-900 dark:text-white flex items-center gap-2"><i class="fa-solid fa-warehouse text-rose-500"></i>Return ke Gudang</h2></div>
            <div class="space-y-3">
              <div><label class="block text-xs font-bold text-slate-500 uppercase mb-1">Pilih Perangkat <span class="text-rose-500">*</span></label><select class="w-full p-3 bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-2xl text-xs font-bold"><option>SN-ONT-99202</option></select></div>
              <div><label class="block text-xs font-bold text-slate-500 uppercase mb-1">Alasan <span class="text-rose-500">*</span></label><textarea rows="2" placeholder="Kelebihan stock / rusak..." class="w-full p-3 bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-2xl text-xs font-medium resize-none"></textarea></div>
              <button type="button" onclick="executeReturnMaterial()" class="w-full py-3 bg-rose-600 hover:bg-rose-700 text-white font-bold text-xs rounded-2xl shadow-md transition-all flex items-center justify-center gap-2"><i class="fa-solid fa-rotate-left"></i>Return Ke Gudang</button>
            </div>
          </div>
        </div>
      </div>

      <!-- ===== ABSENSI ===== -->
      <div id="section-absensi" class="main-section hidden space-y-4 fade-up">
        <div class="bg-white dark:bg-slate-800 rounded-2xl shadow-sm border border-slate-100 dark:border-slate-700">
          <div class="subnav-wrap">
            <button type="button" onclick="switchSubAbsensi('absen-form')" id="sub-abs-absen-form" class="snpill active"><i class="fa-solid fa-user-check text-emerald-600 dark:text-emerald-400"></i><span>Absensi</span></button>
            <button type="button" onclick="switchSubAbsensi('izin-sakit')" id="sub-abs-izin-sakit" class="snpill"><i class="fa-solid fa-notes-medical text-rose-500"></i><span>Izin Sakit</span></button>
            <button type="button" onclick="switchSubAbsensi('izin-cuti')" id="sub-abs-izin-cuti" class="snpill"><i class="fa-solid fa-calendar-minus text-indigo-500"></i><span>Izin Cuti</span></button>
            <button type="button" onclick="switchSubAbsensi('point-absensi')" id="sub-abs-point-absensi" class="snpill"><i class="fa-solid fa-star text-amber-500"></i><span>Point Saya</span></button>
          </div>
        </div>

        <!-- FORM ABSENSI -->
        <div id="sub-abs-content-absen-form" class="sub-abs-content space-y-4">
          <form id="attendance-form" onsubmit="handleFormSubmit(event)" class="bg-white dark:bg-slate-800 rounded-3xl p-6 shadow-sm border border-slate-100 dark:border-slate-700 space-y-5">
            <div class="border-b border-slate-100 dark:border-slate-700 pb-3">
              <h2 class="text-base lg:text-lg font-extrabold text-slate-900 dark:text-white flex items-center gap-2"><i class="fa-solid fa-user-check text-emerald-600 dark:text-emerald-400"></i>Form Absensi Harian</h2>
              <p class="text-xs text-slate-400">Lengkapi data presensi kehadiran Anda</p>
            </div>
            <!-- NAMA -->
            <div class="space-y-1.5">
              <label class="block text-xs font-bold tracking-wider text-slate-500 dark:text-slate-400 uppercase">Nama Karyawan <span class="text-rose-500">*</span></label>
              <div class="relative">
                <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400"><i class="fa-solid fa-user text-sm"></i></div>
                <select id="employeeName" onchange="autoSelectRoleByName(this.value)" required class="w-full pl-10 pr-8 py-3 bg-slate-50/50 dark:bg-slate-700/50 border border-slate-200 dark:border-slate-600 rounded-2xl text-sm font-medium text-slate-800 dark:text-slate-100 focus:outline-none focus:border-emerald-600 transition-all appearance-none"></select>
                <div class="absolute inset-y-0 right-0 pr-3.5 flex items-center pointer-events-none text-slate-400"><i class="fa-solid fa-chevron-down text-xs"></i></div>
              </div>
            </div>
            <!-- DIVISI -->
            <div class="space-y-1.5">
              <label class="block text-xs font-bold tracking-wider text-slate-500 dark:text-slate-400 uppercase">Divisi / Peran <span class="text-rose-500">*</span></label>
              <input type="hidden" id="selectedRole" value="Teknisi">
              <div class="grid grid-cols-3 sm:grid-cols-6 gap-2" id="role-btn-grid">
                <button type="button" id="role-btn-Teknisi" onclick="selectRole('Teknisi',this)" class="role-btn active py-2.5 px-2 rounded-xl border-2 border-blue-600 bg-blue-50 dark:bg-blue-950/40 text-blue-900 dark:text-blue-300 transition-all flex flex-col items-center gap-1"><i class="fa-solid fa-screwdriver-wrench text-blue-600 dark:text-blue-400 text-base"></i><span class="font-bold text-[10px]">Teknisi</span></button>
                <button type="button" id="role-btn-CS" onclick="selectRole('CS',this)" class="role-btn py-2.5 px-2 rounded-xl border-2 border-slate-100 dark:border-slate-700 bg-slate-50 dark:bg-slate-700/50 text-slate-600 dark:text-slate-300 transition-all flex flex-col items-center gap-1 hover:border-slate-300"><i class="fa-solid fa-headset text-indigo-500 text-base"></i><span class="font-bold text-[10px]">CS</span></button>
                <button type="button" id="role-btn-NOC" onclick="selectRole('NOC',this)" class="role-btn py-2.5 px-2 rounded-xl border-2 border-slate-100 dark:border-slate-700 bg-slate-50 dark:bg-slate-700/50 text-slate-600 dark:text-slate-300 transition-all flex flex-col items-center gap-1 hover:border-slate-300"><i class="fa-solid fa-server text-emerald-500 text-base"></i><span class="font-bold text-[10px]">NOC</span></button>
                <button type="button" id="role-btn-Admin" onclick="selectRole('Admin',this)" class="role-btn py-2.5 px-2 rounded-xl border-2 border-slate-100 dark:border-slate-700 bg-slate-50 dark:bg-slate-700/50 text-slate-600 dark:text-slate-300 transition-all flex flex-col items-center gap-1 hover:border-slate-300"><i class="fa-solid fa-user-gear text-blue-500 text-base"></i><span class="font-bold text-[10px]">Admin</span></button>
                <button type="button" id="role-btn-Finance" onclick="selectRole('Finance',this)" class="role-btn py-2.5 px-2 rounded-xl border-2 border-slate-100 dark:border-slate-700 bg-slate-50 dark:bg-slate-700/50 text-slate-600 dark:text-slate-300 transition-all flex flex-col items-center gap-1 hover:border-slate-300"><i class="fa-solid fa-money-bill-wave text-amber-500 text-base"></i><span class="font-bold text-[10px]">Finance</span></button>
                <button type="button" id="role-btn-SPV" onclick="selectRole('SPV',this)" class="role-btn py-2.5 px-2 rounded-xl border-2 border-slate-100 dark:border-slate-700 bg-slate-50 dark:bg-slate-700/50 text-slate-600 dark:text-slate-300 transition-all flex flex-col items-center gap-1 hover:border-slate-300"><i class="fa-solid fa-user-tie text-slate-600 text-base"></i><span class="font-bold text-[10px]">SPV</span></button>
              </div>
            </div>
            <!-- SHIFT (hanya untuk Teknisi weekday) -->
            <div id="shift-section" class="space-y-1.5">
              <label class="block text-xs font-bold tracking-wider text-slate-500 dark:text-slate-400 uppercase">Shift Kerja <span class="text-rose-500">*</span></label>
              <input type="hidden" id="selectedShift" value="Shift1">
              <div class="grid grid-cols-3 gap-2">
                <button type="button" onclick="selectShift('Shift1',this)" class="shift-btn active py-3 rounded-xl border-2 border-blue-600 bg-blue-50 dark:bg-blue-950/40 text-blue-900 dark:text-blue-300 transition-all flex flex-col items-center gap-1">
                  <i class="fa-solid fa-sun text-amber-500 text-base"></i>
                  <span class="font-bold text-[11px]">Shift 1</span>
                  <span class="text-[9px] text-blue-500 dark:text-blue-400 font-semibold" id="shift1-jam-label">08:00 WIB</span>
                </button>
                <button type="button" onclick="selectShift('Shift2',this)" class="shift-btn py-3 rounded-xl border-2 border-slate-100 dark:border-slate-700 bg-slate-50 dark:bg-slate-700/50 text-slate-700 dark:text-slate-300 transition-all flex flex-col items-center gap-1 hover:border-slate-300">
                  <i class="fa-solid fa-cloud-sun text-amber-500 text-base"></i>
                  <span class="font-bold text-[11px]">Shift 2</span>
                  <span class="text-[9px] text-slate-400 font-semibold" id="shift2-jam-label">14:00 WIB</span>
                </button>
                <button type="button" onclick="selectShift('NonShift',this)" class="shift-btn py-3 rounded-xl border-2 border-slate-100 dark:border-slate-700 bg-slate-50 dark:bg-slate-700/50 text-slate-700 dark:text-slate-300 transition-all flex flex-col items-center gap-1 hover:border-slate-300">
                  <i class="fa-solid fa-briefcase text-slate-500 text-base"></i>
                  <span class="font-bold text-[11px]">Non Shift</span>
                  <span class="text-[9px] text-slate-400 font-semibold" id="nonshift-jam-label">09:00 WIB</span>
                </button>
              </div>
              <p id="shift-info-text" class="text-[11px] text-slate-400 italic">Toleransi 15 menit dari jam masuk shift.</p>
            </div>
            <!-- GPS (kondisional berdasarkan role) -->
            <div class="space-y-2">
              <label class="block text-xs font-bold tracking-wider text-slate-500 dark:text-slate-400 uppercase">Lokasi GPS <span id="gps-radius-label" class="font-normal normal-case text-slate-400">(Radius 30m)</span> <span class="text-rose-500">*</span></label>
              <button type="button" onclick="getLocation()" class="w-full py-3 px-4 bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-700 hover:to-teal-700 text-white font-bold text-sm rounded-2xl transition-all shadow-md flex items-center justify-center gap-2 active:scale-[0.99]"><i class="fa-solid fa-location-crosshairs text-base"></i><span>Dapatkan Lokasi Saya</span></button>
              <div class="bg-slate-50/80 dark:bg-slate-700/50 rounded-2xl p-3.5 border border-slate-100 dark:border-slate-700 text-xs flex gap-2.5 items-start">
                <i class="fa-solid fa-location-dot text-emerald-600 dark:text-emerald-400 text-sm mt-0.5"></i>
                <div><p class="font-bold text-slate-800 dark:text-slate-200">Koordinat & Status:</p><p id="location-status" class="text-slate-400 italic mt-0.5 leading-relaxed">Klik tombol untuk mendeteksi GPS.</p></div>
              </div>
            </div>
            <!-- FOTO SELFIE -->
            <div class="space-y-1.5">
              <label class="block text-xs font-bold tracking-wider text-slate-500 dark:text-slate-400 uppercase">Foto Selfie Presensi <span class="text-rose-500">*</span></label>
              <div class="border-2 border-dashed border-slate-200 dark:border-slate-600 rounded-2xl p-4 text-center bg-slate-50/30 dark:bg-slate-700/20 flex flex-col items-center justify-center min-h-[200px] relative overflow-hidden">
                <img id="photo-preview" src="" class="w-full h-44 object-cover rounded-xl hidden border border-slate-200 dark:border-slate-600">
                <div id="camera-placeholder" class="space-y-2 py-3">
                  <div class="w-12 h-12 bg-emerald-100 dark:bg-emerald-900/50 rounded-full flex items-center justify-center text-emerald-600 dark:text-emerald-400 mx-auto"><i class="fa-solid fa-camera text-xl"></i></div>
                  <div><p class="font-bold text-slate-800 dark:text-slate-200 text-sm">Ambil Foto Wajah</p><p class="text-[11px] text-slate-400">Wajah harus terlihat jelas</p></div>
                </div>
                <div id="face-loading-overlay" class="absolute inset-0 bg-slate-900/80 backdrop-blur-sm hidden flex-col items-center justify-center p-4 z-20 text-white rounded-2xl space-y-3">
                  <div class="relative w-16 h-16 border-2 border-emerald-400/30 rounded-2xl flex items-center justify-center overflow-hidden bg-slate-800/50"><div class="scan-line"></div><i class="fa-solid fa-face-smile text-2xl text-emerald-400 animate-pulse"></i></div>
                  <p class="text-xs font-bold text-emerald-300">Analisis Wajah AI...</p>
                </div>
                <input type="file" id="native-camera-input" accept="image/*" capture="user" class="hidden" onchange="handleNativeFileSelect(event)">
                <button type="button" id="btn-camera" onclick="document.getElementById('native-camera-input').click()" class="w-full py-3 px-4 bg-emerald-600 hover:bg-emerald-700 text-white rounded-2xl font-bold text-sm transition-all flex items-center justify-center gap-2 shadow-md mt-3 active:scale-[0.99]"><i class="fa-solid fa-camera"></i><span id="btn-camera-text">Ambil Foto Kamera</span></button>
              </div>
            </div>
            <!-- ALASAN TERLAMBAT -->
            <div class="space-y-1.5 pt-2 border-t border-slate-100 dark:border-slate-700">
              <div class="flex justify-between items-center"><label class="block text-xs font-bold text-slate-500 uppercase">Alasan Keterlambatan</label><span class="text-[10px] text-amber-700 font-semibold bg-amber-50 dark:bg-amber-950/40 px-2.5 py-0.5 rounded-full border border-amber-200 dark:border-amber-800">Isi jika terlambat</span></div>
              <textarea id="lateReason" rows="2" placeholder="Contoh: Ban bocor / kemacetan..." class="w-full p-3 bg-slate-50/50 dark:bg-slate-700/50 border border-slate-200 dark:border-slate-600 rounded-2xl text-xs font-medium focus:outline-none focus:border-amber-500 resize-none"></textarea>
            </div>
            <button type="submit" id="btn-submit" class="w-full py-3.5 px-4 bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-700 hover:to-teal-700 text-white font-bold text-sm rounded-2xl transition-all shadow-md shadow-emerald-600/25 flex items-center justify-center gap-2 active:scale-[0.99]"><i class="fa-solid fa-paper-plane text-sm"></i><span>Kirim Absen Sekarang</span></button>
          </form>
          <div id="success-screen" class="hidden bg-white dark:bg-slate-800 rounded-3xl p-8 shadow-sm border border-slate-100 dark:border-slate-700 text-center space-y-5">
            <div class="w-20 h-20 bg-emerald-100 dark:bg-emerald-950/60 rounded-full flex items-center justify-center mx-auto text-emerald-600 dark:text-emerald-400 shadow-xl"><i class="fa-solid fa-circle-check text-4xl"></i></div>
            <div class="space-y-3"><h2 class="text-2xl font-extrabold text-slate-900 dark:text-white">BERHASIL TERKIRIM</h2><div id="screen-status-badge" class="inline-block px-4 py-2 rounded-2xl border text-sm font-extrabold tracking-wide">--</div>
            <div id="screen-point-earned" class="bg-amber-50 dark:bg-amber-950/40 border border-amber-200 dark:border-amber-800 rounded-2xl p-3 space-y-1">
              <p class="text-[11px] text-amber-600 dark:text-amber-400 font-bold">Point Kehadiran Diperoleh:</p>
              <p id="screen-point-val" class="text-3xl font-black text-amber-600 dark:text-amber-400">+0</p>
            </div></div>
            <button type="button" onclick="resetForm()" class="w-full py-3 bg-slate-100 dark:bg-slate-700 hover:bg-slate-200 text-slate-700 dark:text-slate-200 font-bold text-xs rounded-2xl flex items-center justify-center gap-2"><i class="fa-solid fa-rotate-right"></i>Reset Form</button>
          </div>
        </div>

        <!-- IZIN SAKIT -->
        <div id="sub-abs-content-izin-sakit" class="sub-abs-content hidden">
          <form id="form-sakit" onsubmit="handleLeaveSubmit(event,'Izin Sakit')" class="bg-white dark:bg-slate-800 rounded-3xl p-6 shadow-sm border border-slate-100 dark:border-slate-700 space-y-4">
            <div class="border-b border-slate-100 dark:border-slate-700 pb-3"><h2 class="text-base font-extrabold text-slate-900 dark:text-white flex items-center gap-2"><i class="fa-solid fa-notes-medical text-rose-500"></i>Form Izin Sakit</h2></div>
            <div class="space-y-1.5"><label class="block text-xs font-bold text-slate-500 uppercase">Nama <span class="text-rose-500">*</span></label><div class="relative"><div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400"><i class="fa-solid fa-user text-sm"></i></div><select name="nama" required class="employee-select-sakit w-full pl-10 pr-8 py-3 bg-slate-50 dark:bg-slate-700/50 border border-slate-200 dark:border-slate-600 rounded-2xl text-xs font-medium focus:outline-none focus:border-rose-500 appearance-none"></select><div class="absolute inset-y-0 right-0 pr-3.5 flex items-center pointer-events-none text-slate-400"><i class="fa-solid fa-chevron-down text-xs"></i></div></div></div>
            <div class="space-y-1.5"><label class="block text-xs font-bold text-slate-500 uppercase">Keterangan Sakit <span class="text-rose-500">*</span></label><textarea name="keterangan" required rows="3" placeholder="Demam / Flu berat / Dirawat..." class="w-full p-3 bg-slate-50 dark:bg-slate-700/50 border border-slate-200 dark:border-slate-600 rounded-2xl text-xs font-medium focus:outline-none focus:border-rose-500 resize-none"></textarea></div>
            <div class="space-y-1.5"><label class="block text-xs font-bold text-slate-500 uppercase">Ada Surat Dokter?</label><div class="grid grid-cols-2 gap-2">
              <button type="button" onclick="setSickDocStatus(true,this)" id="btn-ada-surat" class="sick-doc-btn py-2.5 rounded-xl border-2 border-emerald-500 bg-emerald-50 dark:bg-emerald-950/40 text-emerald-700 dark:text-emerald-300 font-bold text-xs flex items-center justify-center gap-2 transition-all"><i class="fa-solid fa-file-medical"></i>Ada Surat</button>
              <button type="button" onclick="setSickDocStatus(false,this)" id="btn-no-surat" class="sick-doc-btn py-2.5 rounded-xl border-2 border-slate-100 dark:border-slate-700 bg-slate-50 dark:bg-slate-700/50 text-slate-600 dark:text-slate-300 font-bold text-xs flex items-center justify-center gap-2 transition-all hover:border-slate-300"><i class="fa-solid fa-file-circle-xmark"></i>Tanpa Surat</button>
            </div></div>
            <div id="sick-doc-upload" class="space-y-1.5"><div class="border-2 border-dashed border-rose-200 dark:border-rose-800 rounded-2xl p-4 text-center relative bg-rose-50/30 dark:bg-rose-950/20"><i class="fa-solid fa-file-medical text-2xl text-rose-400 mb-1"></i><p class="text-xs font-bold text-rose-600 dark:text-rose-400" id="label-file-sakit">Upload Surat Dokter</p><p class="text-[10px] text-slate-400">JPG, PNG, atau PDF</p><input type="file" name="file" accept="image/*,.pdf" class="absolute inset-0 opacity-0 cursor-pointer" onchange="updateFileName(this,'label-file-sakit')"></div></div>
            <div class="bg-rose-50 dark:bg-rose-950/30 border border-rose-100 dark:border-rose-900 rounded-2xl p-3"><p class="text-xs font-bold text-rose-700 dark:text-rose-300">Estimasi Point:</p><p id="sick-point-preview" class="text-lg font-black text-rose-600 dark:text-rose-400">6 poin (dengan surat)</p></div>
            <button type="submit" class="w-full py-3.5 bg-rose-600 hover:bg-rose-700 text-white font-bold text-sm rounded-2xl shadow-md flex items-center justify-center gap-2"><i class="fa-solid fa-paper-plane"></i>Kirim Izin Sakit</button>
          </form>
          <div id="success-screen-sakit" class="hidden bg-white dark:bg-slate-800 rounded-3xl p-8 shadow-sm border text-center space-y-4"><div class="w-20 h-20 bg-rose-100 dark:bg-rose-950/60 rounded-full flex items-center justify-center mx-auto text-rose-600"><i class="fa-solid fa-notes-medical text-4xl"></i></div><h2 class="text-2xl font-black text-slate-900 dark:text-white">IZIN SAKIT TERKIRIM</h2><button type="button" onclick="resetFormSakit()" class="w-full py-3 bg-slate-100 dark:bg-slate-700 text-slate-700 dark:text-slate-200 font-bold text-xs rounded-2xl flex items-center justify-center gap-2"><i class="fa-solid fa-rotate-right"></i>Ajukan Lagi</button></div>
        </div>

        <!-- IZIN CUTI -->
        <div id="sub-abs-content-izin-cuti" class="sub-abs-content hidden">
          <form id="form-cuti" onsubmit="handleLeaveSubmit(event,'Izin Cuti')" class="bg-white dark:bg-slate-800 rounded-3xl p-6 shadow-sm border border-slate-100 dark:border-slate-700 space-y-4">
            <div class="border-b border-slate-100 dark:border-slate-700 pb-3"><h2 class="text-base font-extrabold text-slate-900 dark:text-white flex items-center gap-2"><i class="fa-solid fa-calendar-minus text-indigo-600"></i>Form Izin Cuti</h2></div>
            <div class="space-y-1.5"><label class="block text-xs font-bold text-slate-500 uppercase">Nama <span class="text-rose-500">*</span></label><div class="relative"><div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400"><i class="fa-solid fa-user text-sm"></i></div><select name="nama" required class="employee-select-cuti w-full pl-10 pr-8 py-3 bg-slate-50 dark:bg-slate-700/50 border border-slate-200 dark:border-slate-600 rounded-2xl text-xs font-medium focus:outline-none focus:border-indigo-600 appearance-none"></select><div class="absolute inset-y-0 right-0 pr-3.5 flex items-center pointer-events-none text-slate-400"><i class="fa-solid fa-chevron-down text-xs"></i></div></div></div>
            <div class="space-y-1.5"><label class="block text-xs font-bold text-slate-500 uppercase">Alasan Cuti <span class="text-rose-500">*</span></label><textarea name="keterangan" required rows="3" placeholder="Keperluan keluarga..." class="w-full p-3 bg-slate-50 dark:bg-slate-700/50 border border-slate-200 dark:border-slate-600 rounded-2xl text-xs font-medium focus:outline-none focus:border-indigo-600 resize-none"></textarea></div>
            <div class="space-y-1.5"><label class="block text-xs font-bold text-slate-500 uppercase">Surat Cuti (TTD Supervisor) <span class="text-rose-500">*</span></label><div class="border-2 border-dashed border-indigo-200 dark:border-indigo-800 rounded-2xl p-4 text-center relative bg-indigo-50/30 dark:bg-indigo-950/20"><i class="fa-solid fa-file-signature text-2xl text-indigo-500 mb-1"></i><p class="text-xs font-bold text-indigo-700 dark:text-indigo-300" id="label-file-cuti">Upload Surat Cuti</p><p class="text-[10px] text-slate-400">Harus ada TTD Supervisor</p><input type="file" name="file" required accept="image/*,.pdf" class="absolute inset-0 opacity-0 cursor-pointer" onchange="updateFileName(this,'label-file-cuti')"></div></div>
            <div class="bg-indigo-50 dark:bg-indigo-950/30 border border-indigo-100 dark:border-indigo-900 rounded-2xl p-3"><p class="text-xs font-bold text-indigo-700 dark:text-indigo-300">Estimasi Point: <span class="text-lg font-black">5 poin</span></p></div>
            <button type="submit" class="w-full py-3.5 bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-sm rounded-2xl shadow-md flex items-center justify-center gap-2"><i class="fa-solid fa-paper-plane"></i>Kirim Pengajuan Cuti</button>
          </form>
          <div id="success-screen-cuti" class="hidden bg-white dark:bg-slate-800 rounded-3xl p-8 shadow-sm border text-center space-y-4"><div class="w-20 h-20 bg-indigo-100 dark:bg-indigo-950/60 rounded-full flex items-center justify-center mx-auto text-indigo-600"><i class="fa-solid fa-calendar-check text-4xl"></i></div><h2 class="text-2xl font-black text-slate-900 dark:text-white">CUTI DIAJUKAN</h2><button type="button" onclick="resetFormCuti()" class="w-full py-3 bg-slate-100 dark:bg-slate-700 text-slate-700 dark:text-slate-200 font-bold text-xs rounded-2xl flex items-center justify-center gap-2"><i class="fa-solid fa-rotate-right"></i>Ajukan Lagi</button></div>
        </div>

        <!-- POINT ABSENSI SAYA -->
        <div id="sub-abs-content-point-absensi" class="sub-abs-content hidden space-y-4">
          <div class="bg-gradient-to-br from-amber-500 to-orange-500 rounded-3xl p-5 text-white shadow-lg relative overflow-hidden">
            <div class="absolute -right-4 -bottom-6 opacity-15 pointer-events-none"><i class="fa-solid fa-star text-[100px]"></i></div>
            <p class="text-[10px] font-extrabold tracking-widest uppercase text-amber-200">Point Kehadiran Saya</p>
            <p id="my-attendance-point" class="text-5xl font-black mt-1 leading-none">--</p>
            <p class="text-sm text-amber-200 mt-1">dari maks. <span id="my-max-point" class="font-bold text-white">--</span> poin bulan ini</p>
            <div class="mt-3 bg-white/20 rounded-2xl px-4 py-2.5 flex items-center justify-between">
              <span class="text-xs font-bold text-amber-100">Grade Bulan Ini</span>
              <span id="my-grade-badge" class="text-sm font-black">--</span>
            </div>
          </div>
          <div class="bg-white dark:bg-slate-800 rounded-3xl p-5 shadow-sm border border-slate-100 dark:border-slate-700 space-y-3">
            <h3 class="text-sm font-extrabold text-slate-900 dark:text-white border-b border-slate-100 dark:border-slate-700 pb-3">Panduan Sistem Point</h3>
            <div class="space-y-2 text-xs">
              <div class="flex items-center justify-between p-2.5 bg-emerald-50 dark:bg-emerald-950/30 rounded-xl"><span class="font-semibold text-slate-700 dark:text-slate-200 flex items-center gap-2"><i class="fa-solid fa-circle-check text-emerald-500"></i>Hadir Tepat Waktu</span><span class="font-black text-emerald-600 dark:text-emerald-400">10 poin</span></div>
              <div class="flex items-center justify-between p-2.5 bg-amber-50 dark:bg-amber-950/30 rounded-xl"><span class="font-semibold text-slate-700 dark:text-slate-200 flex items-center gap-2"><i class="fa-solid fa-clock text-amber-500"></i>Terlambat &lt; 30 mnt</span><span class="font-black text-amber-600 dark:text-amber-400">7 poin</span></div>
              <div class="flex items-center justify-between p-2.5 bg-amber-50 dark:bg-amber-950/30 rounded-xl"><span class="font-semibold text-slate-700 dark:text-slate-200 flex items-center gap-2"><i class="fa-solid fa-clock text-amber-600"></i>Terlambat 30–60 mnt</span><span class="font-black text-amber-700 dark:text-amber-300">5 poin</span></div>
              <div class="flex items-center justify-between p-2.5 bg-rose-50 dark:bg-rose-950/30 rounded-xl"><span class="font-semibold text-slate-700 dark:text-slate-200 flex items-center gap-2"><i class="fa-solid fa-clock text-rose-500"></i>Terlambat &gt; 60 mnt</span><span class="font-black text-rose-600 dark:text-rose-400">3 poin</span></div>
              <div class="flex items-center justify-between p-2.5 bg-blue-50 dark:bg-blue-950/30 rounded-xl"><span class="font-semibold text-slate-700 dark:text-slate-200 flex items-center gap-2"><i class="fa-solid fa-file-medical text-blue-500"></i>Izin Sakit + Surat</span><span class="font-black text-blue-600 dark:text-blue-400">6 poin</span></div>
              <div class="flex items-center justify-between p-2.5 bg-blue-50 dark:bg-blue-950/30 rounded-xl"><span class="font-semibold text-slate-700 dark:text-slate-200 flex items-center gap-2"><i class="fa-solid fa-file-circle-xmark text-blue-400"></i>Izin Sakit Tanpa Surat</span><span class="font-black text-blue-500 dark:text-blue-300">4 poin</span></div>
              <div class="flex items-center justify-between p-2.5 bg-indigo-50 dark:bg-indigo-950/30 rounded-xl"><span class="font-semibold text-slate-700 dark:text-slate-200 flex items-center gap-2"><i class="fa-solid fa-calendar-check text-indigo-500"></i>Izin Cuti (disetujui)</span><span class="font-black text-indigo-600 dark:text-indigo-400">5 poin</span></div>
              <div class="flex items-center justify-between p-2.5 bg-slate-50 dark:bg-slate-700/40 rounded-xl"><span class="font-semibold text-slate-700 dark:text-slate-200 flex items-center gap-2"><i class="fa-solid fa-circle-xmark text-slate-400"></i>Tidak Hadir (Alpa)</span><span class="font-black text-slate-500">0 poin</span></div>
              <div class="flex items-center justify-between p-2.5 bg-yellow-50 dark:bg-yellow-950/30 rounded-xl border border-yellow-200 dark:border-yellow-800"><span class="font-semibold text-slate-700 dark:text-slate-200 flex items-center gap-2"><i class="fa-solid fa-award text-yellow-500"></i>Bonus Perfect Attendance</span><span class="font-black text-yellow-600 dark:text-yellow-400">+10 poin</span></div>
            </div>
            <div class="pt-2 border-t border-slate-100 dark:border-slate-700 space-y-1.5">
              <p class="text-xs font-extrabold text-slate-700 dark:text-slate-200">Skala Grade Bulanan:</p>
              <div class="grid grid-cols-2 gap-1.5 text-xs">
                <div class="flex items-center gap-2 p-2 bg-emerald-50 dark:bg-emerald-950/30 rounded-xl"><span class="w-5 h-5 rounded-lg bg-emerald-500 text-white flex items-center justify-center text-[10px] font-black shrink-0">A</span><span class="font-semibold text-slate-600 dark:text-slate-300">90–100% <span class="text-emerald-600 font-black">Excellent</span></span></div>
                <div class="flex items-center gap-2 p-2 bg-blue-50 dark:bg-blue-950/30 rounded-xl"><span class="w-5 h-5 rounded-lg bg-blue-500 text-white flex items-center justify-center text-[10px] font-black shrink-0">B</span><span class="font-semibold text-slate-600 dark:text-slate-300">75–89% <span class="text-blue-600 font-black">Good</span></span></div>
                <div class="flex items-center gap-2 p-2 bg-amber-50 dark:bg-amber-950/30 rounded-xl"><span class="w-5 h-5 rounded-lg bg-amber-500 text-white flex items-center justify-center text-[10px] font-black shrink-0">C</span><span class="font-semibold text-slate-600 dark:text-slate-300">60–74% <span class="text-amber-600 font-black">Average</span></span></div>
                <div class="flex items-center gap-2 p-2 bg-rose-50 dark:bg-rose-950/30 rounded-xl"><span class="w-5 h-5 rounded-lg bg-rose-500 text-white flex items-center justify-center text-[10px] font-black shrink-0">D</span><span class="font-semibold text-slate-600 dark:text-slate-300">&lt;60% <span class="text-rose-600 font-black">Below</span></span></div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- ===== ADMIN ===== -->
      <div id="section-admin" class="main-section hidden space-y-4 fade-up">
        <div class="bg-white dark:bg-slate-800 rounded-2xl shadow-sm border border-slate-100 dark:border-slate-700">
          <div class="subnav-wrap">
            <button type="button" onclick="switchSubAdmin('buat-tugas')" id="sub-adm-buat-tugas" class="snpill active"><i class="fa-solid fa-plus-circle text-blue-600 dark:text-blue-400"></i><span>Buat Tugas</span></button>
            <button type="button" onclick="switchSubAdmin('registrasi')" id="sub-adm-registrasi" class="snpill"><i class="fa-solid fa-server text-indigo-500"></i><span>Registrasi</span></button>
            <button type="button" onclick="switchSubAdmin('tambah-perangkat')" id="sub-adm-tambah-perangkat" class="snpill"><i class="fa-solid fa-plus-square text-emerald-500"></i><span>Tambah Perangkat</span></button>
            <button type="button" onclick="switchSubAdmin('list-perangkat')" id="sub-adm-list-perangkat" class="snpill"><i class="fa-solid fa-cubes text-slate-500"></i><span>List Perangkat</span></button>
            <button type="button" onclick="switchSubAdmin('approval-pickup')" id="sub-adm-approval-pickup" class="snpill"><i class="fa-solid fa-user-check text-amber-500"></i><span>Approval</span></button>
            <button type="button" onclick="switchSubAdmin('tracking-perangkat')" id="sub-adm-tracking-perangkat" class="snpill"><i class="fa-solid fa-route text-rose-500"></i><span>Tracking</span></button>
          </div>
        </div>

        <!-- BUAT TUGAS + LIST TUGAS (2 kolom) -->
        <div id="sub-adm-content-buat-tugas" class="sub-adm-content space-y-4">
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
            <!-- FORM BUAT WO -->
            <form onsubmit="handleCreateTask(event)" id="form-buat-wo" class="bg-white dark:bg-slate-800 rounded-3xl p-5 shadow-sm border border-slate-100 dark:border-slate-700 space-y-4">
              <div class="border-b border-slate-100 dark:border-slate-700 pb-3"><h2 class="text-sm font-extrabold text-slate-900 dark:text-white flex items-center gap-2"><i class="fa-solid fa-plus-circle text-blue-600"></i>Buat Tiket WO Baru</h2><p class="text-[11px] text-slate-400">Release ke teknisi / NOC</p></div>
              <!-- CS Info -->
              <div class="bg-blue-50 dark:bg-blue-950/40 border border-blue-100 dark:border-blue-900 rounded-2xl px-3 py-2.5 flex items-center gap-2.5">
                <div class="w-8 h-8 rounded-xl bg-blue-600 text-white font-black text-xs flex items-center justify-center shrink-0" id="wo-cs-avatar">--</div>
                <div><p class="text-xs font-extrabold text-slate-800 dark:text-slate-100" id="wo-cs-name">--</p><p class="text-[10px] text-blue-600 dark:text-blue-400 font-semibold">CS pembuat tiket</p></div>
                <span class="ml-auto text-[10px] bg-blue-600 text-white font-bold px-2 py-0.5 rounded-full" id="wo-timestamp-now">--</span>
              </div>
              <!-- T1 -->
              <div class="bg-amber-50 dark:bg-amber-950/30 border border-amber-200 dark:border-amber-800 rounded-2xl p-3 space-y-2">
                <div class="flex items-center gap-2"><i class="fa-brands fa-whatsapp text-emerald-500"></i><label class="block text-xs font-extrabold text-slate-700 dark:text-slate-200 uppercase">T1 — Jam Permintaan Masuk <span class="text-rose-500">*</span></label></div>
                <input type="time" id="wo-t1-time" required class="w-full p-2.5 bg-white dark:bg-slate-700 border border-amber-300 dark:border-amber-700 rounded-xl text-sm font-extrabold text-slate-800 dark:text-slate-100 focus:outline-none focus:border-amber-500 tracking-widest">
              </div>
              <!-- TIPE WO -->
              <div><label class="block text-xs font-bold text-slate-500 uppercase mb-1">Tipe WO <span class="text-rose-500">*</span></label>
                <select id="wo-tipe" required onchange="onWoTipeChange()" class="w-full p-2.5 bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-xl text-xs font-bold">
                  <option value="INSTALASI">Instalasi Baru</option>
                  <option value="INSTALASI_RESELLER">Instalasi Reseller</option>
                  <option value="PERLUASAN_RESELLER">Perluasan Reseller</option>
                  <option value="MAINTENANCE">Maintenance</option>
                  <option value="GANGGUAN">Gangguan / Komplain</option>
                </select>
              </div>

              <!-- ===== FIELDS INSTALASI BARU ===== -->
              <div id="wo-fields-instalasi" class="space-y-3">
                <div><label class="block text-xs font-bold text-slate-500 uppercase mb-1">Nama Pelanggan <span class="text-rose-500">*</span></label><input type="text" id="wo-pelanggan" placeholder="Bpk. Hendra Wijaya" class="w-full p-2.5 bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-xl text-xs font-medium"></div>
                <div><label class="block text-xs font-bold text-slate-500 uppercase mb-1">No. HP <span class="text-rose-500">*</span></label><input type="tel" id="wo-nohp" placeholder="08xx-xxxx-xxxx" class="w-full p-2.5 bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-xl text-xs font-medium"></div>
                <div><label class="block text-xs font-bold text-slate-500 uppercase mb-1">Alamat <span class="text-rose-500">*</span></label><textarea id="wo-alamat" rows="2" placeholder="Alamat lengkap..." class="w-full p-2.5 bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-xl text-xs font-medium resize-none"></textarea></div>
                <div class="grid grid-cols-2 gap-3">
                  <div><label class="block text-xs font-bold text-slate-500 uppercase mb-1">Registrasi (Rp)</label><input type="number" id="wo-registrasi" placeholder="50000" class="w-full p-2.5 bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-xl text-xs font-medium"></div>
                  <div><label class="block text-xs font-bold text-slate-500 uppercase mb-1">Paket Mbps (Rp)</label><input type="number" id="wo-paket" placeholder="150000" oninput="hitungTotalWO()" class="w-full p-2.5 bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-xl text-xs font-medium"></div>
                </div>
                <div><label class="block text-xs font-bold text-slate-500 uppercase mb-1">Nama Paket</label><input type="text" id="wo-nama-paket" placeholder="Paket 20 Mbps" class="w-full p-2.5 bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-xl text-xs font-medium"></div>
                <div><label class="block text-xs font-bold text-slate-500 uppercase mb-1">Total Keseluruhan (Rp)</label><input type="number" id="wo-total" readonly placeholder="Auto dihitung" class="w-full p-2.5 bg-slate-100 dark:bg-slate-600 border border-slate-200 dark:border-slate-600 rounded-xl text-xs font-bold text-emerald-600"></div>
                <div><label class="block text-xs font-bold text-slate-500 uppercase mb-1">Marketing</label><input type="text" id="wo-marketing" placeholder="Nama marketing" class="w-full p-2.5 bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-xl text-xs font-medium"></div>
              </div>

              <!-- ===== FIELDS INSTALASI RESELLER ===== -->
              <div id="wo-fields-reseller" class="space-y-3 hidden">
                <div><label class="block text-xs font-bold text-slate-500 uppercase mb-1">Nama Reseller <span class="text-rose-500">*</span></label><input type="text" id="wo-nama-reseller" placeholder="Nama reseller" class="w-full p-2.5 bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-xl text-xs font-medium"></div>
                <div><label class="block text-xs font-bold text-slate-500 uppercase mb-1">No. HP <span class="text-rose-500">*</span></label><input type="tel" id="wo-nohp-reseller" placeholder="08xx-xxxx-xxxx" class="w-full p-2.5 bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-xl text-xs font-medium"></div>
                <div><label class="block text-xs font-bold text-slate-500 uppercase mb-1">Alamat <span class="text-rose-500">*</span></label><textarea id="wo-alamat-reseller" rows="2" placeholder="Alamat lengkap..." class="w-full p-2.5 bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-xl text-xs font-medium resize-none"></textarea></div>
                <div class="grid grid-cols-2 gap-3">
                  <div><label class="block text-xs font-bold text-slate-500 uppercase mb-1">Registrasi (Rp)</label><input type="number" id="wo-registrasi-reseller" value="250000" class="w-full p-2.5 bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-xl text-xs font-medium" oninput="hitungTotalWOReseller()"></div>
                  <div><label class="block text-xs font-bold text-slate-500 uppercase mb-1">Paket Voucher (Rp)</label><input type="number" id="wo-paket-voucher" value="240000" class="w-full p-2.5 bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-xl text-xs font-medium" oninput="hitungTotalWOReseller()"></div>
                </div>
                <div><label class="block text-xs font-bold text-slate-500 uppercase mb-1">Total Keseluruhan (Rp)</label><input type="number" id="wo-total-reseller" readonly placeholder="Auto dihitung" class="w-full p-2.5 bg-slate-100 dark:bg-slate-600 border border-slate-200 dark:border-slate-600 rounded-xl text-xs font-bold text-emerald-600"></div>
                <div><label class="block text-xs font-bold text-slate-500 uppercase mb-1">Penggunaan Kabel (meter)</label><input type="number" id="wo-kabel-reseller" placeholder="50" class="w-full p-2.5 bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-xl text-xs font-medium"></div>
                <div><label class="block text-xs font-bold text-slate-500 uppercase mb-1">Marketing</label><input type="text" id="wo-marketing-reseller" placeholder="Nama marketing" class="w-full p-2.5 bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-xl text-xs font-medium"></div>
                <div><label class="block text-xs font-bold text-slate-500 uppercase mb-1">Status Koneksi</label>
                  <select id="wo-status-koneksi-reseller" class="w-full p-2.5 bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-xl text-xs font-bold">
                    <option value="Reseller">Reseller</option><option value="Rumahan">Rumahan</option>
                  </select>
                </div>
              </div>

              <!-- ===== FIELDS PERLUASAN RESELLER ===== -->
              <div id="wo-fields-perluasan" class="space-y-3 hidden">
                <div><label class="block text-xs font-bold text-slate-500 uppercase mb-1">Nama Reseller <span class="text-rose-500">*</span></label><input type="text" id="wo-reseller-perluasan" placeholder="Nama reseller" class="w-full p-2.5 bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-xl text-xs font-medium"></div>
                <div><label class="block text-xs font-bold text-slate-500 uppercase mb-1">Nama Pelanggan <span class="text-rose-500">*</span></label><input type="text" id="wo-pelanggan-perluasan" placeholder="Nama pelanggan baru" class="w-full p-2.5 bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-xl text-xs font-medium"></div>
                <div><label class="block text-xs font-bold text-slate-500 uppercase mb-1">Alamat <span class="text-rose-500">*</span></label><textarea id="wo-alamat-perluasan" rows="2" placeholder="Alamat pelanggan..." class="w-full p-2.5 bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-xl text-xs font-medium resize-none"></textarea></div>
                <div><label class="block text-xs font-bold text-slate-500 uppercase mb-1">Jumlah Titik <span class="text-rose-500">*</span></label><input type="number" id="wo-titik-perluasan" placeholder="Contoh: 3" min="1" class="w-full p-2.5 bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-xl text-xs font-medium"></div>
                <div><label class="block text-xs font-bold text-slate-500 uppercase mb-1">SN Access Point / ONT</label><input type="text" id="wo-sn-ap-perluasan" placeholder="SN-AP-XXXXX" class="w-full p-2.5 bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-xl text-xs font-medium uppercase"></div>
                <div><label class="block text-xs font-bold text-slate-500 uppercase mb-1">Kebutuhan Kabel</label>
                  <div class="grid grid-cols-2 gap-2">
                    <div><select id="wo-jenis-kabel-perluasan" class="w-full p-2.5 bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-xl text-xs font-bold"><option value="RJ45">Kabel RJ45</option><option value="Precon">Kabel Precon</option><option value="Dropcore">Kabel Dropcore</option></select></div>
                    <div><input type="number" id="wo-meter-kabel-perluasan" placeholder="meter" class="w-full p-2.5 bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-xl text-xs font-medium"></div>
                  </div>
                </div>
              </div>

              <!-- ===== FIELDS MAINTENANCE ===== -->
              <div id="wo-fields-maintenance" class="space-y-3 hidden">
                <div><label class="block text-xs font-bold text-slate-500 uppercase mb-1">Nama Pelanggan <span class="text-rose-500">*</span></label><input type="text" id="wo-pelanggan-maint" placeholder="Bpk. Hendra Wijaya" class="w-full p-2.5 bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-xl text-xs font-medium"></div>
                <div><label class="block text-xs font-bold text-slate-500 uppercase mb-1">Alamat <span class="text-rose-500">*</span></label><textarea id="wo-alamat-maint" rows="2" placeholder="Alamat lengkap..." class="w-full p-2.5 bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-xl text-xs font-medium resize-none"></textarea></div>
                <div><label class="block text-xs font-bold text-slate-500 uppercase mb-1">Titik Koordinat</label><input type="text" id="wo-koordinat-maint" placeholder="-6.xxxx, 106.xxxx (opsional)" class="w-full p-2.5 bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-xl text-xs font-medium"></div>
                <div><label class="block text-xs font-bold text-slate-500 uppercase mb-1">Kendala <span class="text-rose-500">*</span></label><textarea id="wo-kendala-maint" rows="3" placeholder="Jelaskan kendala yang dialami pelanggan..." class="w-full p-2.5 bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-xl text-xs font-medium resize-none"></textarea></div>
                <div class="bg-amber-50 dark:bg-amber-950/30 border border-amber-200 dark:border-amber-800 rounded-2xl p-3 text-[11px] text-amber-700 dark:text-amber-300 flex items-start gap-2"><i class="fa-solid fa-circle-info mt-0.5"></i><span>WO Maintenance otomatis masuk ke antrian <strong>NOC</strong> untuk diagnosa.</span></div>
              </div>

              <!-- ===== FIELDS GANGGUAN ===== -->
              <div id="wo-fields-gangguan" class="space-y-3 hidden">
                <div><label class="block text-xs font-bold text-slate-500 uppercase mb-1">Nama Pelanggan <span class="text-rose-500">*</span></label><input type="text" id="wo-pelanggan-gangguan" placeholder="Bpk. Hendra Wijaya" class="w-full p-2.5 bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-xl text-xs font-medium"></div>
                <div><label class="block text-xs font-bold text-slate-500 uppercase mb-1">No. HP</label><input type="tel" id="wo-nohp-gangguan" placeholder="08xx-xxxx-xxxx" class="w-full p-2.5 bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-xl text-xs font-medium"></div>
                <div><label class="block text-xs font-bold text-slate-500 uppercase mb-1">Alamat <span class="text-rose-500">*</span></label><textarea id="wo-alamat-gangguan" rows="2" placeholder="Alamat lengkap..." class="w-full p-2.5 bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-xl text-xs font-medium resize-none"></textarea></div>
                <div><label class="block text-xs font-bold text-slate-500 uppercase mb-1">Kendala</label><textarea id="wo-kendala-gangguan" rows="2" placeholder="Jelaskan gangguan..." class="w-full p-2.5 bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-xl text-xs font-medium resize-none"></textarea></div>
              </div>

              <button type="submit" class="w-full py-3 bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs rounded-2xl shadow-md transition-all flex items-center justify-center gap-2 active:scale-[0.99]"><i class="fa-solid fa-paper-plane"></i>Release Tiket WO</button>
            </form>
            <!-- LIST TIKET AKTIF -->
            <div class="bg-white dark:bg-slate-800 rounded-3xl p-5 shadow-sm border border-slate-100 dark:border-slate-700 space-y-3">
              <div class="border-b border-slate-100 dark:border-slate-700 pb-3"><h2 class="text-sm font-extrabold text-slate-900 dark:text-white flex items-center gap-2"><i class="fa-solid fa-list-check text-slate-600 dark:text-slate-400"></i>List Tiket Aktif</h2><p class="text-[11px] text-slate-400">Semua WO yang sudah dirilis</p></div>
              <div id="admin-ticket-list" class="space-y-2">
                <div class="p-3 bg-blue-50 dark:bg-blue-950/30 rounded-xl border border-blue-100 dark:border-blue-900 space-y-1">
                  <div class="flex items-center justify-between"><span class="text-[10px] font-extrabold text-blue-600 dark:text-blue-400 font-mono">WO-202608-010</span><span class="text-[10px] bg-blue-100 text-blue-700 dark:bg-blue-950 dark:text-blue-300 px-2 py-0.5 rounded-full font-bold">RELEASE</span></div>
                  <p class="text-xs font-bold text-slate-800 dark:text-slate-100">Bpk. Hendra Wijaya</p>
                  <p class="text-[10px] text-slate-400">INSTALASI • Jl. Raya Kebon Jeruk</p>
                </div>
                <div class="p-3 bg-amber-50 dark:bg-amber-950/30 rounded-xl border border-amber-100 dark:border-amber-900 space-y-1">
                  <div class="flex items-center justify-between"><span class="text-[10px] font-extrabold text-blue-600 dark:text-blue-400 font-mono">WO-202608-011</span><span class="text-[10px] bg-amber-100 text-amber-700 dark:bg-amber-950 dark:text-amber-300 px-2 py-0.5 rounded-full font-bold">PROSES</span></div>
                  <p class="text-xs font-bold text-slate-800 dark:text-slate-100">Ibu Siska Pratama</p>
                  <p class="text-[10px] text-slate-400">MAINTENANCE • Gading Asri Blok F2</p>
                </div>
                <div class="p-3 bg-emerald-50 dark:bg-emerald-950/30 rounded-xl border border-emerald-100 dark:border-emerald-900 space-y-1">
                  <div class="flex items-center justify-between"><span class="text-[10px] font-extrabold text-blue-600 dark:text-blue-400 font-mono">WO-202608-001</span><span class="text-[10px] bg-emerald-100 text-emerald-700 dark:bg-emerald-950 dark:text-emerald-300 px-2 py-0.5 rounded-full font-bold">SELESAI</span></div>
                  <p class="text-xs font-bold text-slate-800 dark:text-slate-100">Bpk. Ahmad Subagja</p>
                  <p class="text-[10px] text-slate-400">INSTALASI • Jl. Mawar No. 12</p>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- REGISTRASI -->
        <div id="sub-adm-content-registrasi" class="sub-adm-content hidden space-y-4">
          <div class="bg-white dark:bg-slate-800 rounded-3xl p-5 shadow-sm border border-slate-100 dark:border-slate-700 space-y-4">
            <div class="border-b border-slate-100 dark:border-slate-700 pb-3"><h2 class="text-sm font-extrabold text-slate-900 dark:text-white flex items-center gap-2"><i class="fa-solid fa-server text-indigo-600"></i>Antrian Registrasi Provisioning</h2><p class="text-[11px] text-slate-400">Request dari teknisi yang menunggu aktivasi</p></div>
            <div id="provisioning-queue-list" class="space-y-3">
              <div class="p-4 bg-indigo-50 dark:bg-indigo-950/30 rounded-2xl border border-indigo-200 dark:border-indigo-800 space-y-3">
                <div class="flex items-center justify-between"><div><p class="text-xs font-black text-slate-900 dark:text-white">WO-202608-010 — Bpk. Hendra Wijaya</p><p class="text-[10px] text-slate-400">Teknisi 1 • 28 Aug 2026, 11:30 WIB</p></div><span class="px-2.5 py-1 rounded-full text-[10px] font-extrabold bg-amber-100 text-amber-700 flex items-center gap-1"><i class="fa-solid fa-spinner animate-spin text-xs"></i>On Going</span></div>
                <div class="grid grid-cols-2 gap-2 text-xs"><div><p class="font-bold text-slate-500 uppercase text-[10px]">ONT SN</p><p class="font-extrabold font-mono">SN-ONT-99202</p></div><div><p class="font-bold text-slate-500 uppercase text-[10px]">ODP</p><p class="font-extrabold">ODP-JKT-01 Port 4</p></div></div>
                <button type="button" onclick="completeProvisioning('WO-202608-010')" class="w-full py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold rounded-xl transition-all flex items-center justify-center gap-1.5"><i class="fa-solid fa-circle-check"></i>Tandai Selesai</button>
              </div>
            </div>
          </div>
        </div>

        <!-- TAMBAH PERANGKAT -->
        <div id="sub-adm-content-tambah-perangkat" class="sub-adm-content hidden space-y-4">
          <form onsubmit="handleAddDevice(event)" class="bg-white dark:bg-slate-800 rounded-3xl p-5 shadow-sm border border-slate-100 dark:border-slate-700 space-y-4">
            <div class="border-b border-slate-100 dark:border-slate-700 pb-3"><h2 class="text-sm font-extrabold text-slate-900 dark:text-white flex items-center gap-2"><i class="fa-solid fa-plus-square text-emerald-600"></i>Input Perangkat Gudang</h2></div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div><label class="block text-xs font-bold text-slate-500 uppercase mb-1">Serial Number <span class="text-rose-500">*</span></label><input type="text" required placeholder="SN-ONT-99300" class="w-full p-2.5 bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-xl text-xs font-extrabold uppercase"></div>
              <div><label class="block text-xs font-bold text-slate-500 uppercase mb-1">Jenis <span class="text-rose-500">*</span></label><select required class="w-full p-2.5 bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-xl text-xs font-bold"><option value="Modem/ONT">Modem / ONT</option><option value="Kabel Dropcore">Kabel Dropcore</option><option value="STB">STB TV</option></select></div>
            </div>
            <div><label class="block text-xs font-bold text-slate-500 uppercase mb-1">Kondisi <span class="text-rose-500">*</span></label><select required class="w-full p-2.5 bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-xl text-xs font-bold"><option value="Baru">Baru (New Stock)</option><option value="Dismantle">Dismantle (Bekas)</option><option value="Rusak">Rusak (Defective)</option></select></div>
            <div class="bg-emerald-50 dark:bg-emerald-950/30 border border-emerald-200 dark:border-emerald-800 rounded-2xl p-3 space-y-2">
              <p class="text-xs font-extrabold text-emerald-700 dark:text-emerald-300 flex items-center gap-2"><i class="fa-solid fa-file-excel"></i>Import dari Excel (.xlsx)</p>
              <p class="text-[11px] text-slate-500 dark:text-slate-400">Format: SN | Jenis | Kondisi</p>
              <div class="flex gap-2"><input type="file" id="excel-perangkat" accept=".xlsx,.xls" class="flex-1 text-xs p-2 bg-white dark:bg-slate-700 border border-emerald-200 dark:border-emerald-700 rounded-xl"><button type="button" onclick="importPerangkatExcel()" class="px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold rounded-xl shrink-0 flex items-center gap-1.5"><i class="fa-solid fa-upload"></i>Import</button></div>
            </div>
            <button type="submit" class="w-full py-3 bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs rounded-2xl shadow-md transition-all flex items-center justify-center gap-2"><i class="fa-solid fa-database"></i>Simpan Ke Database</button>
          </form>
        </div>

        <!-- LIST PERANGKAT -->
        <div id="sub-adm-content-list-perangkat" class="sub-adm-content hidden space-y-3">
          <div class="bg-white dark:bg-slate-800 rounded-3xl p-5 shadow-sm border border-slate-100 dark:border-slate-700 space-y-4">
            <div class="border-b border-slate-100 dark:border-slate-700 pb-3 flex items-center justify-between">
              <h2 class="text-sm font-extrabold text-slate-900 dark:text-white flex items-center gap-2"><i class="fa-solid fa-cubes text-blue-600"></i>List Seluruh Perangkat</h2>
              <button type="button" onclick="loadAndRenderListPerangkat()" class="px-2.5 py-1 bg-slate-100 dark:bg-slate-700 hover:bg-slate-200 text-slate-600 dark:text-slate-300 rounded-lg text-[10px] font-bold flex items-center gap-1"><i class="fa-solid fa-rotate-right text-[10px]"></i>Refresh</button>
            </div>
            <div class="overflow-x-auto rounded-2xl border border-slate-100 dark:border-slate-700">
              <table class="w-full text-left border-collapse">
                <thead><tr class="bg-slate-50 dark:bg-slate-700/50 text-[11px] font-extrabold text-slate-500 dark:text-slate-400 uppercase tracking-wider border-b border-slate-100 dark:border-slate-700">
                  <th class="py-3 px-4">SN</th><th class="py-3 px-3">Jenis</th><th class="py-3 px-3 text-center">Kondisi</th><th class="py-3 px-3 text-center">Lokasi</th>
                </tr></thead>
                <tbody id="admin-list-perangkat-tbody" class="divide-y divide-slate-100 dark:divide-slate-700 text-xs font-medium text-slate-700 dark:text-slate-200">
